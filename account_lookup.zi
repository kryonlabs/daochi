#import "std/go_types"
identity :: #import "identity";
ctx :: #import "std/context_go";
sql :: #import "std/sql_go";
errors :: #import "std/errors_go";

AccountResult :: struct {
    value: string
    found: bool
    error: Error
}

#scope_file
ValidAliasReference :: (value: string) -> bool {
    if value.count < 1 || value.count > 32 {
        return false
    }
    for byte: value {
        if !(byte >= cast(u8)97 && byte <= cast(u8)122) &&
            !(byte >= cast(u8)48 && byte <= cast(u8)57) && byte != cast(u8)95 {
            return false
        }
    }
    return true
}

#scope_export
Resolve :: (database: *sql.Database, context: ctx.Context, reference: string) -> AccountResult {
    result: AccountResult
    reference = identity.NormalizeAccountAlias(reference)
    arguments: [1]Any
    arguments[0] = reference
    destinations: [1]Any
    if identity.ValidUserID(reference) {
        result.value = reference
        exists: isize
        destinations[0] = *exists
        row := sql.QueryRow(database, context, "SELECT EXISTS(SELECT 1 FROM server_users WHERE user_id_hash=?1)", arguments[:])
        result.error = sql.ScanRow(row, destinations[:])
        result.found = exists != cast(isize)0
        return result
    }
    if !ValidAliasReference(reference) {
        return result
    }
    destinations[0] = *result.value
    row := sql.QueryRow(database, context, "SELECT user_id_hash FROM server_users WHERE alias=?1 COLLATE NOCASE ORDER BY julianday(created_at),rowid LIMIT 1", arguments[:])
    result.error = sql.ScanRow(row, destinations[:])
    if errors.Is(result.error, sql.NoRows()) {
        result.error = null
        return result
    }
    result.found = true
    return result
}
