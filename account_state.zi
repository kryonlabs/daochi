#import "std/go_types"
ctx :: #import "std/context_go";
sql :: #import "std/sql_go";
timestamp :: #import "timestamp";
go_sql :: #system_library "go:database/sql";

#scope_file
ExecResult :: struct {
    value: sql.Result
    error: Error
}
UpdateSeen :: (transaction: *sql.Transaction, context: ctx.Context, query: string, userID: string, seen: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
EnsureSync :: (transaction: *sql.Transaction, context: ctx.Context, query: string, userID: string) -> ExecResult #go_results #foreign go_sql "(*Tx).ExecContext";
QueryTombstone :: (database: *sql.Database, context: ctx.Context, query: string, userID: string) -> *sql.Row #foreign go_sql "(*DB).QueryRowContext";
ScanCount :: (row: *sql.Row, count: *isize) -> Error #foreign go_sql "(*Row).Scan";
QueryVersion :: (transaction: *sql.Transaction, context: ctx.Context, query: string, userID: string) -> *sql.Row #foreign go_sql "(*Tx).QueryRowContext";
ScanVersion :: (row: *sql.Row, version: *s64) -> Error #foreign go_sql "(*Row).Scan";

#scope_export
TombstoneResult :: struct {
    value: bool
    error: Error
}
VersionResult :: struct {
    value: s64
    error: Error
}

NextVersion :: (transaction: *sql.Transaction, context: ctx.Context, userID: string) -> VersionResult {
    result: VersionResult
    inserted := EnsureSync(transaction, context,
        "INSERT OR IGNORE INTO server_sync_state(user_id_hash,server_version) VALUES(?1,0)", userID)
    result.error = inserted.error
    if result.error != null {
        return result
    }
    updated := EnsureSync(transaction, context,
        "UPDATE server_sync_state SET server_version=server_version+1 WHERE user_id_hash=?1", userID)
    result.error = updated.error
    if result.error != null {
        return result
    }
    row := QueryVersion(transaction, context,
        "SELECT server_version FROM server_sync_state WHERE user_id_hash=?1", userID)
    result.error = ScanVersion(row, *result.value)
    return result
}

Affected :: (value: sql.Result) -> isize {
    affected := sql.RowsAffected(value)
    if affected.error != null {
        return cast(isize)0
    }
    return cast(isize)affected.value
}

Tombstoned :: (database: *sql.Database, context: ctx.Context, userID: string) -> TombstoneResult {
    result: TombstoneResult
    count: isize = 0
    row := QueryTombstone(database, context,
        "SELECT EXISTS(SELECT 1 FROM server_account_tombstones WHERE user_id_hash=?1)", userID)
    result.error = ScanCount(row, *count)
    result.value = count != cast(isize)0
    return result
}

Touch :: (transaction: *sql.Transaction, context: ctx.Context, userID: string, missingUser: Error) -> Error {
    updated := UpdateSeen(transaction, context,
        "UPDATE server_users SET last_seen_at=?2 WHERE user_id_hash=?1", userID, timestamp.CanonicalNow())
    if updated.error != null {
        return updated.error
    }
    affected := sql.RowsAffected(updated.value)
    if affected.error != null || cast(isize)affected.value == cast(isize)0 {
        return missingUser
    }
    inserted := EnsureSync(transaction, context,
        "INSERT OR IGNORE INTO server_sync_state(user_id_hash,server_version) VALUES(?1,0)", userID)
    return inserted.error
}
