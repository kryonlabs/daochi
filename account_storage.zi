// An account's billable content on this node. Basic tracking is free;
// custom text, encrypted payloads, blobs, lists and publications may be limited.
#import "std/go_types"
#import "sync_types"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
errors :: #import "std/errors_go";
http :: #import "std/http_go";
response :: #import "response";
identity :: #import "identity";
plans :: #import "storage_plan";
clock :: #import "std/time_go";
native :: #system_library "go:database/sql";
go_os :: #system_library "go:os";
go_fmt :: #system_library "go:fmt";

UsageResult :: struct {
    value: s64
    error: Error
}

StorageFullResponse :: struct {
    Message: string #go_tag "json:\"error\""
    Code: string #go_tag "json:\"code\""
    AccountStorage: AccountStorage #go_tag "json:\"account_storage\""
}

ErrStorageFull: Error = errors.New("account storage limit reached");

#scope_file
UsageSQL :: "SELECT COALESCE((SELECT used_bytes FROM server_storage_usage WHERE user_id_hash=?1),0)";
BlobStoredSQL :: "SELECT EXISTS(SELECT 1 FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3)";
BlobRecordSQL :: "INSERT OR IGNORE INTO server_blobs(user_id_hash,app_id,hash,size) VALUES(?1,?2,?3,?4)";
BlobForgetSQL :: "DELETE FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3";
RemoveAllRaw :: (path: string) -> Error #foreign go_os "RemoveAll";
Concat :: (a: string, b: string) -> string #foreign go_fmt "Sprint";
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";

#scope_export
Limit :: (database: *sql.Database, context: ctx.Context, user: string,
    baseline: s64, enabled: bool) -> UsageResult {
    result: UsageResult
    result.value = baseline
    if !enabled {
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    RollbackAtReturn(opened.value)
    limited := plans.LimitTx(opened.value, context, user, baseline, enabled, clock.Unix(clock.Now()))
    result.value = limited.value
    result.error = limited.error
    return result
}

Used :: (database: *sql.Database, context: ctx.Context, userID: string) -> UsageResult {
    result: UsageResult
    arguments: [1]Any = .[userID]
    destinations: [1]Any = .[*result.value]
    row := sql.QueryRow(database, context, UsageSQL, arguments[:])
    result.error = sql.ScanRow(row, destinations[:])
    return result
}

UsedTx :: (transaction: *sql.Transaction, context: ctx.Context, userID: string) -> UsageResult {
    result: UsageResult
    arguments: [1]Any = .[userID]
    destinations: [1]Any = .[*result.value]
    row := sql.QueryRowTx(transaction, context, UsageSQL, arguments[:])
    result.error = sql.ScanRow(row, destinations[:])
    return result
}

// A write may not grow an account past a positive limit. Writes that keep or
// shrink usage still apply, so an account above its limit can free space.
Exceeds :: (before: s64, after: s64, limit: s64) -> bool {
    if limit <= 0 {
        return false
    }
    return after > limit && after > before
}

Report :: (used: s64, limit: s64) -> AccountStorage {
    result: AccountStorage
    result.UsedBytes = used
    if limit > 0 {
        result.LimitBytes = limit
    }
    return result
}

RespondFull :: (writer: http.ResponseWriter, storage: AccountStorage) {
    value: StorageFullResponse
    value.Message = "account storage limit reached"
    value.Code = "storage_full"
    value.AccountStorage = storage
    response.JSON(writer, cast(isize)413, value)
}

BlobStoredResult :: struct {
    value: bool
    error: Error
}

// Blobs live in files beside the database, one folder per account.
BlobAccountFolder :: (dbPath: string, userID: string) -> string {
    return Concat(Concat(Concat(dbPath, ".blobs"), "/"), userID)
}

BlobStored :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> BlobStoredResult {
    result: BlobStoredResult
    arguments: [3]Any = .[userID, appID, hash]
    destinations: [1]Any = .[*result.value]
    result.error = sql.ScanRow(sql.QueryRow(database, context, BlobStoredSQL, arguments[:]), destinations[:])
    return result
}

RecordBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string, size: s64) -> Error {
    arguments: [4]Any = .[userID, appID, hash, size]
    written := sql.Exec(database, context, BlobRecordSQL, arguments[:])
    return written.error
}

// A deleted blob no longer counts toward the account's storage.
ForgetBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> Error {
    arguments: [3]Any = .[userID, appID, hash]
    written := sql.Exec(database, context, BlobForgetSQL, arguments[:])
    return written.error
}

// Account deletion removes the account's rows; this removes its blob files,
// which would otherwise keep its ciphertext on disk.
RemoveBlobs :: (dbPath: string, userID: string) -> Error {
    if !identity.ValidUserID(userID) {
        return errors.New("invalid blob account")
    }
    return RemoveAllRaw(BlobAccountFolder(dbPath, userID))
}
