// An account's billable content on this node. Basic tracking is free;
// custom text, encrypted payloads, blobs, lists and publications may be limited.
#import "std/go_types"
#import "sync_types"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
errors :: #import "std/errors_go";
http :: #import "std/http_go";
response :: #import "response";
identity :: #import "identity";
plans :: #import "storage_plan";
clock :: #import "std/time_go";
native :: #system_library "go:database/sql";
go_os :: #system_library "go:os";
go_fmt :: #system_library "go:fmt";
go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

UsageResult :: struct {
    value: s64
    error: Error
}

// A blob in the account's trash stays this long, then it is deleted.
TrashDays :: 30

StorageFullResponse :: struct {
    Message: string #go_tag "json:\"error\""
    Code: string #go_tag "json:\"code\""
    AccountStorage: AccountStorage #go_tag "json:\"account_storage\""
}

ErrStorageFull: Error = errors.New("account storage limit reached");

#scope_file
UsageSQL :: "SELECT COALESCE((SELECT used_bytes FROM server_storage_usage WHERE user_id_hash=?1),0)";
BlobStoredSQL :: "SELECT EXISTS(SELECT 1 FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3)";
BlobTrashedSQL :: "SELECT EXISTS(SELECT 1 FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3 AND trashed_at<>0)";
BlobSizeSQL :: "SELECT size FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3";
// Storing a blob again takes it out of the trash.
BlobRecordSQL :: #string SQL_END
INSERT INTO server_blobs(user_id_hash,app_id,hash,size) VALUES(?1,?2,?3,?4)
ON CONFLICT(user_id_hash,app_id,hash) DO UPDATE SET trashed_at=0 WHERE trashed_at<>0
SQL_END;
BlobForgetSQL :: "DELETE FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3";
BlobTrashSQL :: "UPDATE server_blobs SET trashed_at=?4 WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3 AND trashed_at=0";
BlobRestoreSQL :: "UPDATE server_blobs SET trashed_at=0 WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3";
TrashedBlobsSQL :: "SELECT user_id_hash,app_id,hash FROM server_blobs WHERE trashed_at<>0 AND trashed_at<=?1";
ForgetTrashedSQL :: "DELETE FROM server_blobs WHERE user_id_hash=?1 AND app_id=?2 AND hash=?3 AND trashed_at<>0 AND trashed_at<=?4";
Day :: 86400
AllocateBlobs :: (count: isize) -> []TrashedBlob #foreign builtin "make";
AppendBlob :: (values: []TrashedBlob, value: TrashedBlob) -> []TrashedBlob #foreign builtin "append";
CloseRowsAtReturn :: (rows: *sql.Rows) #go_defer #foreign native "(*Rows).Close";
Join :: (values: []string, separator: string) -> string #foreign go_strings;
Remove :: (path: string) -> Error #foreign go_os;
IsNotExist :: (error: Error) -> bool #foreign go_os;
TrashedBlob :: struct {
    user: string
    app: string
    hash: string
}
RemoveAllRaw :: (path: string) -> Error #foreign go_os "RemoveAll";
Concat :: (a: string, b: string) -> string #foreign go_fmt "Sprint";
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";

#scope_export
Limit :: (database: *sql.Database, context: ctx.Context, user: string,
    baseline: s64, enabled: bool) -> UsageResult {
    result: UsageResult
    result.value = baseline
    if !enabled {
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    RollbackAtReturn(opened.value)
    limited := plans.LimitTx(opened.value, context, user, baseline, enabled, clock.Unix(clock.Now()))
    result.value = limited.value
    result.error = limited.error
    return result
}

Used :: (database: *sql.Database, context: ctx.Context, userID: string) -> UsageResult {
    result: UsageResult
    arguments: [1]Any = .[userID]
    destinations: [1]Any = .[*result.value]
    row := sql.QueryRow(database, context, UsageSQL, arguments[:])
    result.error = sql.ScanRow(row, destinations[:])
    return result
}

UsedTx :: (transaction: *sql.Transaction, context: ctx.Context, userID: string) -> UsageResult {
    result: UsageResult
    arguments: [1]Any = .[userID]
    destinations: [1]Any = .[*result.value]
    row := sql.QueryRowTx(transaction, context, UsageSQL, arguments[:])
    result.error = sql.ScanRow(row, destinations[:])
    return result
}

// A write may not grow an account past a positive limit. Writes that keep or
// shrink usage still apply, so an account above its limit can free space.
Exceeds :: (before: s64, after: s64, limit: s64) -> bool {
    if limit <= 0 {
        return false
    }
    return after > limit && after > before
}

Report :: (used: s64, limit: s64) -> AccountStorage {
    result: AccountStorage
    result.UsedBytes = used
    if limit > 0 {
        result.LimitBytes = limit
    }
    return result
}

RespondFull :: (writer: http.ResponseWriter, storage: AccountStorage) {
    value: StorageFullResponse
    value.Message = "account storage limit reached"
    value.Code = "storage_full"
    value.AccountStorage = storage
    response.JSON(writer, cast(isize)413, value)
}

BlobStoredResult :: struct {
    value: bool
    error: Error
}

// Blobs live in files beside the database, one folder per account.
BlobAccountFolder :: (dbPath: string, userID: string) -> string {
    return Concat(Concat(Concat(dbPath, ".blobs"), "/"), userID)
}

BlobStored :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> BlobStoredResult {
    result: BlobStoredResult
    arguments: [3]Any = .[userID, appID, hash]
    destinations: [1]Any = .[*result.value]
    result.error = sql.ScanRow(sql.QueryRow(database, context, BlobStoredSQL, arguments[:]), destinations[:])
    return result
}

RecordBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string, size: s64) -> Error {
    arguments: [4]Any = .[userID, appID, hash, size]
    written := sql.Exec(database, context, BlobRecordSQL, arguments[:])
    return written.error
}

// A blob in the trash stays readable but no longer counts toward storage.
// Whether a blob was there to move: an unknown blob cannot be trashed.
TrashBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string, now: s64) -> BlobStoredResult {
    result := BlobStored(database, context, userID, appID, hash)
    if result.error != null || !result.value {
        return result
    }
    arguments: [4]Any = .[userID, appID, hash, now]
    written := sql.Exec(database, context, BlobTrashSQL, arguments[:])
    result.error = written.error
    return result
}

BlobTrashed :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> BlobStoredResult {
    result: BlobStoredResult
    arguments: [3]Any = .[userID, appID, hash]
    destinations: [1]Any = .[*result.value]
    result.error = sql.ScanRow(sql.QueryRow(database, context, BlobTrashedSQL, arguments[:]), destinations[:])
    return result
}

BlobSize :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> UsageResult {
    result: UsageResult
    arguments: [3]Any = .[userID, appID, hash]
    destinations: [1]Any = .[*result.value]
    result.error = sql.ScanRow(sql.QueryRow(database, context, BlobSizeSQL, arguments[:]), destinations[:])
    return result
}

// Takes a blob out of the trash, so it counts toward storage again.
RestoreBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> Error {
    arguments: [3]Any = .[userID, appID, hash]
    written := sql.Exec(database, context, BlobRestoreSQL, arguments[:])
    return written.error
}

// Deletes, file and row, every blob trashed at least TrashDays before now.
PurgeTrashedBlobs :: (database: *sql.Database, context: ctx.Context, dbPath: string, now: s64) -> Error {
    cutoff := now - cast(s64)(TrashDays * Day)
    arguments: [1]Any = .[cutoff]
    queried := sql.Query(database, context, TrashedBlobsSQL, arguments[:])
    if queried.error != null {
        return queried.error
    }
    due := TrashedBlobsDue(queried.value)
    if due.error != null {
        return due.error
    }
    for blob: due.value {
        if !identity.ValidUserID(blob.user) || !identity.ValidNamespace(blob.app) || !ValidBlobHash(blob.hash) {
            continue
        }
        parts: [7]string = .[dbPath, ".blobs/", blob.user, "/", blob.app, "/", blob.hash]
        removed := Remove(Join(parts[:], ""))
        if removed != null && !IsNotExist(removed) {
            return removed
        }
        values: [4]Any = .[blob.user, blob.app, blob.hash, cutoff]
        forgotten := sql.Exec(database, context, ForgetTrashedSQL, values[:])
        if forgotten.error != null {
            return forgotten.error
        }
    }
    return null
}

// A deleted blob no longer counts toward the account's storage.
ForgetBlob :: (database: *sql.Database, context: ctx.Context, userID: string, appID: string,
    hash: string) -> Error {
    arguments: [3]Any = .[userID, appID, hash]
    written := sql.Exec(database, context, BlobForgetSQL, arguments[:])
    return written.error
}

TrashedBlobsResult :: struct {
    value: []TrashedBlob
    error: Error
}

// Reads every due blob first: the store's one connection must be free
// before the deletions.
TrashedBlobsDue :: (rows: *sql.Rows) -> TrashedBlobsResult {
    result: TrashedBlobsResult
    CloseRowsAtReturn(rows)
    values := AllocateBlobs(cast(isize)0)
    while sql.Next(rows) {
        blob: TrashedBlob
        destinations: [3]Any = .[*blob.user, *blob.app, *blob.hash]
        result.error = sql.ScanRows(rows, destinations[:])
        if result.error != null {
            return result
        }
        values = AppendBlob(values, blob)
    }
    result.value = values
    result.error = sql.RowsError(rows)
    return result
}

// 64 lowercase hexadecimal digits, as blob addresses are.
ValidBlobHash :: (hash: string) -> bool {
    if hash.count != 64 {
        return false
    }
    for byte: hash {
        digit := byte >= 48 && byte <= 57
        letter := byte >= 97 && byte <= 102
        if !digit && !letter {
            return false
        }
    }
    return true
}

// Account deletion removes the account's rows; this removes its blob files,
// which would otherwise keep its ciphertext on disk.
RemoveBlobs :: (dbPath: string, userID: string) -> Error {
    if !identity.ValidUserID(userID) {
        return errors.New("invalid blob account")
    }
    return RemoveAllRaw(BlobAccountFolder(dbPath, userID))
}
