AliasOffer :: struct {
    category: string
    units: s64
}

#scope_file
Has :: (words: string, alias: string) -> bool {
    for word: Fields(words) {
        if word == alias {
            return true
        }
    }
    return false
}

#scope_export
Find :: (alias: string) -> AliasOffer {
    result: AliasOffer
    if Has(BrandWords, alias) {
        result.category = "brand"
        result.units = BrandDew * DewUnits
    } else if Has(CommonNames, alias) || Has(CommonWords, alias) {
        result.category = "common"
        result.units = CommonDew * DewUnits
    } else if alias.count == 4 {
        result.category = "four_character"
        result.units = FourCharacterDew * DewUnits
    } else {
        result.category = "standard"
    }
    return result
}
