// Exact normalized names only: adding a suffix does not inherit a price.
// Sources and selection policy are documented in docs/premium-usernames.md.
strings :: #system_library "go:strings";
Fields :: (value: string) -> []string #foreign strings;

DewUnits :: 1000000
FourCharacterDew :: 100
CommonDew :: 250
BrandDew :: 1000

