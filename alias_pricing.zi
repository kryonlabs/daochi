// A new name and its signed Dew debit commit together. Existing aliases are
// never migrated or charged; setting the account's current alias is a no-op.
#import "std/go_types"
#import "protocol"
catalog :: #import "alias_catalog";
identity :: #import "identity";
ledger :: #import "token_ledger";
receipts :: #import "token_receipt";
timestamp :: #import "timestamp";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
ed :: #import "std/ed25519_go";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
strings :: #system_library "go:strings";

AliasQuote :: struct {
    alias: string #go_tag "json:\"alias\""
    enabled: bool #go_tag "json:\"enabled\""
    available: bool #go_tag "json:\"available\""
    owned: bool #go_tag "json:\"owned\""
    premium: bool #go_tag "json:\"premium\""
    category: string #go_tag "json:\"category\""
    price_units: s64 #go_tag "json:\"price_units\""
    units_per_dew: s64 #go_tag "json:\"units_per_dew\""
    minimum_length: s64 #go_tag "json:\"minimum_length\""
    maximum_length: s64 #go_tag "json:\"maximum_length\""
    error: Error #go_tag "json:\"-\""
}

AliasClaimResult :: struct {
    alias: string #go_tag "json:\"alias\""
    price_units: s64 #go_tag "json:\"price_units\""
    receipt_id: string #go_tag "json:\"receipt_id,omitempty\""
    error: Error #go_tag "json:\"-\""
}

#scope_file
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";
Join :: (values: []string, separator: string) -> string #foreign strings;
Contains :: (value: string, part: string) -> bool #foreign strings;

#scope_export
Price :: (database: *sql.Database, context: ctx.Context, account: string, alias: string,
    enabled: bool) -> AliasQuote {
    result: AliasQuote
    result.alias = alias
    result.enabled = enabled
    result.units_per_dew = catalog.DewUnits
    result.minimum_length = 4
    result.maximum_length = 32
    owner: string
    arguments: [1]Any = .[alias]
    destinations: [1]Any = .[*owner]
    result.error = sql.ScanRow(sql.QueryRow(database, context,
        "SELECT user_id_hash FROM server_users WHERE alias=?1", arguments[:]), destinations[:])
    if errors.Is(result.error, sql.NoRows()) {
        result.error = null
        result.available = true
    } else if result.error != null {
        return result
    } else {
        result.owned = owner == account
    }
    // A grandfathered alias remains usable even if today's grammar differs.
    if alias == "" || (!identity.ValidAccountAlias(alias) && !result.owned) {
        result.error = errors.New("invalid alias")
        return result
    }
    result.category = "standard"
    if enabled {
        offer := catalog.Find(alias)
        result.category = offer.category
        result.premium = offer.units > 0
        if !result.owned {
            result.price_units = offer.units
        }
    }
    return result
}

Claim :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey,
    account: string, alias: string, enabled: bool, confirmedUnits: s64, requestID: string) -> AliasClaimResult {
    result: AliasClaimResult
    result.alias = alias
    if requestID != "" && !identity.ValidID(requestID, 8, 128) {
        result.error = errors.New("invalid request_id")
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    current: string
    arguments: [1]Any = .[account]
    destinations: [1]Any = .[*current]
    result.error = sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT COALESCE(alias,'') FROM server_users WHERE user_id_hash=?1", arguments[:]), destinations[:])
    if errors.Is(result.error, sql.NoRows()) {
        result.error = errors.New("sync account not found")
    }
    if result.error != null {
        return result
    }
    keyParts: [2]string = .["username:", requestID]
    key := Join(keyParts[:], "")
    if requestID != "" {
        receiptID: string
        paidArguments: [2]Any = .[account, key]
        paidDestinations: [1]Any = .[*receiptID]
        paid := sql.ScanRow(sql.QueryRowTx(transaction, context,
            "SELECT receipt_id FROM token_spend_nonces WHERE account_id=?1 AND app_id='entity' AND idempotency_key=?2",
            paidArguments[:]), paidDestinations[:])
        if paid == null {
            receipt := ledger.ByIDTx(transaction, context, receiptID)
            result.error = receipt.error
            if result.error != null {
                return result
            }
            if !receipt.found || receipt.value.SourceType != "username" ||
            receipt.value.SourceRef != alias || receipt.value.AmountDelta != -confirmedUnits {
                result.error = errors.New("request_id reused for a different claim")
                return result
            }
            // Replaying an old purchase cannot take the name back after a rename.
            if current != alias {
                result.error = errors.New("claim already completed; alias changed")
                return result
            }
            result.price_units = -receipt.value.AmountDelta
            result.receipt_id = receiptID
            return result
        }
        if !errors.Is(paid, sql.NoRows()) {
            result.error = paid
            return result
        }
    }
    if current != "" && current == alias {
        return result
    }
    if !identity.ValidAccountAlias(alias) {
        result.error = errors.New("invalid alias")
        return result
    }
    owner: string
    ownerArguments: [1]Any = .[alias]
    ownerDestinations: [1]Any = .[*owner]
    taken := sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT user_id_hash FROM server_users WHERE alias=?1", ownerArguments[:]), ownerDestinations[:])
    if taken == null {
        result.error = errors.New("alias unavailable")
        return result
    }
    if !errors.Is(taken, sql.NoRows()) {
        result.error = taken
        return result
    }
    if enabled {
        offer := catalog.Find(alias)
        result.price_units = offer.units
    }
    if result.price_units > 0 && (requestID == "" || confirmedUnits == 0) {
        result.error = errors.New("premium alias requires explicit purchase at the quoted price")
        return result
    }
    if confirmedUnits != result.price_units {
        result.error = errors.New("alias price changed; request a new quote")
        return result
    }
    updateArguments: [3]Any = .[account, alias, timestamp.CanonicalNow()]
    updated := sql.ExecTx(transaction, context,
        "UPDATE server_users SET alias=?2,last_seen_at=?3 WHERE user_id_hash=?1", updateArguments[:])
    result.error = updated.error
    if result.error != null {
        if Contains(errors.Message(result.error), "UNIQUE") {
            result.error = errors.New("alias unavailable")
        }
        return result
    }
    if result.price_units > 0 {
        event: receipts.TokenEventInput
        event.AccountID = account
        event.AppID = "entity"
        event.EventType = "debit"
        event.AmountDelta = -result.price_units
        event.SourceType = "username"
        event.SourceRef = alias
        debit := ledger.SpendTx(transaction, context, signer, event, key,
            errors.New("Dew issuer unavailable"))
        result.error = debit.error
        if result.error != null {
            return result
        }
        result.receipt_id = debit.value.ReceiptID
    }
    result.error = sql.Commit(transaction)
    return result
}

Status :: (error: Error) -> isize {
    message := errors.Message(error)
    if message == "invalid alias" || message == "invalid request_id" {
        return 400
    }
    if message == "sync account not found" {
        return 404
    }
    if message == "insufficient balance" ||
    message == "premium alias requires explicit purchase at the quoted price" {
        return 402
    }
    if message == "alias unavailable" || message == "request_id reused for a different claim" ||
    message == "claim already completed; alias changed" || message == "alias price changed; request a new quote" {
        return 409
    }
    return 503
}
