#import "std/go_types"
#import "manifest"
network :: #import "network_scope";
ctx :: #import "std/context_go";
sql :: #import "std/sql_go";
json :: #import "std/json_go";
text :: #import "std/text_go";
errors :: #import "std/errors_go";
go_sql :: #system_library "go:database/sql";

#scope_file
RowsResult :: struct { value: *sql.Rows; error: Error; }
Query :: (database: *sql.Database, context: ctx.Context, query: string) -> RowsResult #go_results #foreign go_sql "(*DB).QueryContext";
ScanManifest :: (rows: *sql.Rows, value: *string) -> Error #foreign go_sql "(*Rows).Scan";
CloseAtReturn :: (rows: *sql.Rows) #go_defer #foreign go_sql "(*Rows).Close";

#scope_export
Allowed :: (scope: network.NetworkScope, value: AppManifest) -> bool {
    if !value.LANOnly {
        return value.LANNetworks.count == 0
    }
    if !scope.LANOnly || !network.ValidNetworks(value.LANNetworks) || !network.ValidNetworks(scope.Networks) {
        return false
    }
    for allowed: scope.Networks {
        child := network.ParseCIDR(allowed)
        found := false
        for declared: value.LANNetworks {
            parent := network.ParseCIDR(declared)
            if network.Contains(parent.network, network.NetworkIP(child.network)) && network.Narrower(child.network, parent.network) {
                found = true
            }
        }
        if !found {
            return false
        }
    }
    return true
}

StoredAllowed :: (scope: network.NetworkScope, database: *sql.Database, context: ctx.Context) -> Error {
    queried := Query(database, context, "SELECT manifest_json FROM server_app_manifests")
    if queried.error != null {
        return queried.error
    }
    CloseAtReturn(queried.value)
    while sql.Next(queried.value) {
        encoded: string
        error := ScanManifest(queried.value, *encoded)
        if error != null {
            return error
        }
        value: AppManifest
        error = json.Unmarshal(text.ToBytes(encoded), *value)
        if error != null {
            return error
        }
        if !Allowed(scope, value) {
            return errors.New("stored app manifest forbids this node network scope")
        }
    }
    return sql.RowsError(queried.value)
}

