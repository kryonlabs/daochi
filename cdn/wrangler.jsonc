{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "daochi-packages",
  "main": "worker.mjs",
  "compatibility_date": "2026-10-02",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    {
      "pattern": "api.waozi.xyz/api/v2/packages/*",
      "zone_name": "waozi.xyz"
    }
  ],
  "r2_buckets": [
    {
      "binding": "ARTIFACTS",
      "bucket_name": "daochi-packages"
    }
  ],
  "observability": {
    "enabled": false
  }
}
