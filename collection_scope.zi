#import "std/go_types"
ctx :: #import "std/context_go";
sql :: #import "std/sql_go";
go_sql :: #system_library "go:database/sql";
go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

CollectionMatcher :: struct {
    AppID: string
    DisplayName: string
    Prefix: string
    MatchPrefix: string
    Wildcard: bool
    Specificity: isize
}
MatchersResult :: struct {
    value: []CollectionMatcher
    error: Error
}

#scope_file
RowsResult :: struct {
    value: *sql.Rows
    error: Error
}
Query :: (database: *sql.Database, context: ctx.Context, query: string) -> RowsResult #go_results #foreign go_sql "(*DB).QueryContext";
Scan :: (rows: *sql.Rows, app: *string, name: *string, prefix: *string) -> Error #foreign go_sql "(*Rows).Scan";
CloseAtReturn :: (rows: *sql.Rows) #go_defer #foreign go_sql "(*Rows).Close";
Append :: (values: []CollectionMatcher, value: CollectionMatcher) -> []CollectionMatcher #foreign builtin "append";
TrimSuffix :: (value: string, suffix: string) -> string #foreign go_strings;
HasPrefix :: (value: string, prefix: string) -> bool #foreign go_strings;

#scope_export
Load :: (database: *sql.Database, context: ctx.Context) -> MatchersResult {
    result: MatchersResult
    queried := Query(database, context, MatchersSQL)
    result.error = queried.error
    if result.error != null {
        return result
    }
    rows := queried.value
    CloseAtReturn(rows)
    values: []CollectionMatcher
    while sql.Next(rows) {
        matcher: CollectionMatcher
        result.error = Scan(rows, *matcher.AppID, *matcher.DisplayName, *matcher.Prefix)
        if result.error != null {
            return result
        }
        matcher.MatchPrefix = TrimSuffix(matcher.Prefix, "*")
        matcher.Wildcard = matcher.MatchPrefix != matcher.Prefix
        matcher.Specificity = cast(isize)matcher.MatchPrefix.count
        values = Append(values, matcher)
    }
    result.error = sql.RowsError(rows)
    if result.error != null {
        return result
    }
    result.value = values
    return result
}

Best :: (collection: string, matchers: []CollectionMatcher) -> *CollectionMatcher {
    best: *CollectionMatcher
    index: s64 = 0
    while index < matchers.count {
        matcher := *matchers[index]
        matches := collection == matcher.MatchPrefix
        if matcher.Wildcard {
            matches = HasPrefix(collection, matcher.MatchPrefix)
        }
        if matches && (best == null || matcher.Specificity > best.Specificity) {
            best = matcher
        }
        index += 1
    }
    return best
}

#scope_file
MatchersSQL :: #string SQL_END
SELECT a.app_id,a.display_name,c.collection_prefix
FROM server_apps a
JOIN server_app_collections c ON c.app_id=a.app_id
ORDER BY a.app_id,c.collection_prefix
SQL_END;
