# How much Dew one XMR buys on the production node: 10,000 Dew = 1 XMR.
# Raising MONERO_RATE_TOKEN_UNITS by a whole factor makes the next deploy
# multiply every Dew balance once under DEW_RESCALE, so give each raise a new
# name. See apply-dew-ratio.sh.
MONERO_RATE_ATOMIC_AMOUNT=1000000000000
MONERO_RATE_TOKEN_UNITS=10000000000
DEW_RESCALE=rescale-v2
# Dew products the node sells, as id:Dew. The Google Play products buy the
# same Dew. A deploy adds each one the node lacks to DAOCHI_TOKEN_PRODUCTS at
# the ratio above; products the node already sells keep their amounts, and a
# raised ratio scales them like every other product.
DEW_PRODUCTS=dew_100:100,dew_500:500,dew_1000:1000,dew_5000:5000
