# Settings each deploy writes into the production node's environment, in
# place of the lines that set the same names. See set-environment.sh.
#
# The Android apps whose Google Play purchases buy Dew.
DAOCHI_GOOGLE_PACKAGE_NAMES=xyz.waozi.wurm,xyz.waozi.shovey,xyz.waozi.inbe

# Charge only new premium username claims; existing usernames stay untouched.
DAOCHI_PREMIUM_ALIASES_ENABLED=true

# Google clients whose sign-in tokens this node accepts; apps ask for the first.
# Client IDs are public: they appear in every token.
DAOCHI_GOOGLE_SIGNIN_CLIENT_IDS=623036578670-q21ph1k0305db7ami30dg8bnpdqsg8g5.apps.googleusercontent.com
