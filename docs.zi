#import "std/go_types"
#import "std/map_go"
#import "protocol"
#import "types"
http :: #import "std/http_go";
io :: #import "std/io_go";
ctx :: #import "std/context_go";
json :: #import "std/json_go";
url :: #import "std/url_go";
response :: #import "response";
chat_paths :: #import "chat_paths";
telegram_paths :: #import "telegram_paths";
authorization_paths :: #import "authorization_paths";
package_paths :: #import "package_paths";
go_sync :: #system_library "go:sync";
go_format :: #system_library "go:fmt";
go_slog :: #system_library "go:log/slog";
go_io :: #system_library "go:io";
builtin :: #system_library "go:builtin";
go_strings :: #system_library "go:strings";

ReadPublicStats :: #type (context: ctx.Context, databasePath: string) -> PublicStatsResult;

#scope_file
CachedBytes :: #type () -> []u8;
WriteResult :: struct {
    count: isize
    error: Error
}
OnceBytes :: (build: CachedBytes) -> CachedBytes #foreign go_sync "OnceValue";
AppendByte :: (values: []u8, value: u8) -> []u8 #foreign builtin "append";
AppendObject :: (values: []Map(string, Any), value: Map(string, Any)) -> []Map(string, Any) #foreign builtin "append";
AllocateStrings :: (count: isize) -> []string #foreign builtin "make";
AllocateObjects :: (count: isize) -> []Map(string, Any) #foreign builtin "make";
AllocateIntegers :: (count: isize) -> []isize #foreign builtin "make";
Write :: (writer: io.Writer, value: []u8) -> WriteResult #go_results #foreign go_io "Writer.Write";
WritePage :: (writer: io.Writer, format: string, status: string) -> WriteResult #go_results #foreign go_format "Fprintf";
FormatStatus :: (format: string, users: s64, used: s64, total: s64, repeatedUsers: s64, repeatedUsed: s64, repeatedTotal: s64) -> string #foreign go_format "Sprintf";
FormatFailure :: (format: string, error: Error) -> string #foreign go_format "Sprintf";
Panic :: (value: Any) #foreign builtin "panic";
LogError :: (message: string, key: string, error: Error) #foreign go_slog "Error";
Join :: (parts: []string, separator: string) -> string #foreign go_strings;

cachedSpec: CachedBytes = OnceBytes(BuildSpecJSON);
pageTemplate: string = BuildPage();

BuildSpecJSON :: () -> []u8 {
    encoded := json.Marshal(Spec())
    if encoded.error != null {
        Panic(FormatFailure("marshal openapi spec: %v", encoded.error))
    }
    return AppendByte(encoded.value, cast(u8)10)
}

#scope_export
OpenAPI :: (writer: http.ResponseWriter, request: *http.Request) {
    http.SetHeader(http.ResponseHeaders(writer), "Content-Type", "application/vnd.oai.openapi+json")
    http.WriteHeader(writer, cast(isize)200)
    Write(cast(io.Writer)writer, cachedSpec())
}

Handle :: (writer: http.ResponseWriter, request: *http.Request, databasePath: string, read: ReadPublicStats) {
    if url.Path(http.RequestURL(request)) != "/" {
        response.Error(writer, cast(isize)404, "not found")
        return
    }
    loaded := read(http.Context(request), databasePath)
    statusHTML: string = "<p class=\"status-error\">Stats are temporarily unavailable.</p>"
    if loaded.error != null {
        LogError("load public stats", "error", loaded.error)
    } else {
        stats := loaded.value
        usedGB := stats.StorageUsedGB
        if stats.StorageUsedBytes > 0 && usedGB == 0 {
            usedGB = 1
        }
        totalGB := usedGB + stats.AvailableGB
        statusHTML = FormatStatus(StatusTemplate, stats.UserCount, usedGB, totalGB,
            stats.UserCount, usedGB, totalGB)
    }
    http.SetHeader(http.ResponseHeaders(writer), "Content-Type", "text/html; charset=utf-8")
    http.WriteHeader(writer, cast(isize)200)
    WritePage(cast(io.Writer)writer, pageTemplate, statusHTML)
}

#scope_file
StatusTemplate :: "<footer class=\"status\" aria-label=\"Users: %d; Storage: %d/%d GB\">\n<span><strong>Users</strong> %d</span>\n<span><strong>Storage</strong> %d/%d GB</span>\n</footer>";

BuildPage :: () -> string {
    parts: [5]string
    parts[0] = #string PAGE_SECTION_0
<!doctype html>
<html lang="en">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1">
<title>Daochi</title>
<style>
@import url('https://fonts.googleapis.com/css2?family=Noto+Sans+Mono:ital,wght@0,300;0,400;0,600;1,400&family=Cormorant+Garamond:ital,wght@0,500;0,600;1,500&display=swap');
body{font-family:"Noto Sans Mono",ui-monospace,Menlo,monospace;margin:0;line-height:1.85;color:#4a4038;background:linear-gradient(180deg,#f7ede2 0%%,#f2e2d0 60%%,#f7ede2 100%%);font-size:13.5px}
main{max-width:1040px;margin:0 auto;padding:44px 20px 28px}
.hero{padding:54px 0 42px;border-bottom:1px solid #d8cdbd}
