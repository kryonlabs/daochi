Paths :: () -> Map(string, Any) {
    result: Map(string, Any)
    MapInit(result)
    additions := chat_paths.Paths()
    MapSet(result, "/api/v1/chat/completions", MapGet(additions, "/api/v1/chat/completions"))
    MapSet(result, "/api/v1/feedback", MapGet(additions, "/api/v1/feedback"))
    MapSet(result, "/api/v1/admin/feedback", MapGet(additions, "/api/v1/admin/feedback"))
    MapSet(result, "/api/v1/admin/feedback/reply", MapGet(additions, "/api/v1/admin/feedback/reply"))
    telegram := telegram_paths.Paths()
    telegramNames: [12]string = .["/api/v1/lumi/telegram/link", "/api/v1/lumi/telegram/updates",
        "/api/v1/lumi/telegram/ack", "/api/v1/lumi/telegram/messages", "/api/v1/lumi/telegram/webhook",
        "/api/v1/telegram/environment", "/api/v1/telegram/entry", "/api/v1/telegram/entry/verify",
        "/api/v1/telegram/entry/status", "/api/v1/telegram/entry/rendezvous", "/api/v1/telegram/entry/cancel", "/api/v1/telegram/account/bind"]
    for name: telegramNames {
        MapSet(result, name, MapGet(telegram, name))
    }
    authorization := authorization_paths.Paths()
    authorizationNames: [10]string = .["/api/v1/authorization/requests", "/api/v1/authorization/rendezvous",
        "/api/v1/authorization/cancel", "/api/v1/authorization/claim", "/api/v1/authorization/approve",
        "/api/v1/authorization/revoke", "/api/v1/authorization/challenge", "/api/v1/authorization/session",
        "/api/v1/delegated/sync", "/api/v1/delegated/ws"]
    for name: authorizationNames {
        MapSet(result, name, MapGet(authorization, name))
    }
    packages := package_paths.Paths()
    MapSet(result, "/api/v1/packages/{app_id}/{asset}", MapGet(packages, "/api/v1/packages/{app_id}/{asset}"))
    MapSet(result, "/api/v2/packages/{app_id}/{asset}", MapGet(packages, "/api/v2/packages/{app_id}/{asset}"))
    MapSet(result, "/healthz", PathHealthz())
    MapSet(result, "/readyz", PathReadyz())
    MapSet(result, "/api/v1/node", PathApiV1Node())
    MapSet(result, "/api/v1/node/pairing/invites", PathApiV1NodePairingInvites())
    MapSet(result, "/api/v1/node/pairing/accept", PathApiV1NodePairingAccept())
    MapSet(result, "/api/v1/node/pairing/complete", PathApiV1NodePairingComplete())
    MapSet(result, "/api/v1/node/peers", PathApiV1NodePeers())
    MapSet(result, "/api/v1/namespaces", PathApiV1Namespaces())
    MapSet(result, "/api/v1/namespaces/claims", PathApiV1NamespacesClaims())
    MapSet(result, "/api/v1/namespaces/resolve", PathApiV1NamespacesResolve())
    MapSet(result, "/api/v1/node/mesh/export", PathApiV1NodeMeshExport())
    MapSet(result, "/api/v1/node/mesh/import", PathApiV1NodeMeshImport())
    MapSet(result, "/metrics", PathMetrics())
    MapSet(result, "/api/v1/tokens/assets", PathApiV1TokensAssets())
    MapSet(result, "/api/v1/tokens/issuer", PathApiV1TokensIssuer())
    MapSet(result, "/api/v1/tokens/products", PathApiV1TokensProducts())
    MapSet(result, "/api/v1/tokens/balance", PathApiV1TokensBalance())
    MapSet(result, "/api/v1/tokens/ledger", PathApiV1TokensLedger())
    MapSet(result, "/api/v1/tokens/spend", PathApiV1TokensSpend())
    MapSet(result, "/api/v1/tokens/purchases/google/verify", PathApiV1TokensPurchasesGoogleVerify())
    MapSet(result, "/api/v1/tokens/purchases/monero/invoices", PathApiV1TokensPurchasesMoneroInvoices())
    MapSet(result, "/api/v1/tokens/purchases/monero/invoices/{id}", PathApiV1TokensPurchasesMoneroInvoicesId())
    MapSet(result, "/api/v1/tokens/purchases/monero/address", PathApiV1TokensPurchasesMoneroAddress())
    MapSet(result, "/api/v1/tokens/purchases/monero/address/{recipient}", PathApiV1TokensPurchasesMoneroAddressRecipient())
    MapSet(result, "/api/v1/tokens/purchases/monero/deposits", PathApiV1TokensPurchasesMoneroDeposits())
    MapSet(result, "/api/v1/tokens/checkpoints/latest", PathApiV1TokensCheckpointsLatest())
    MapSet(result, "/api/v1/tokens/receipts/{receipt_id}", PathApiV1TokensReceiptsReceiptId())
    MapSet(result, "/api/v1/admin/tokens/manual-credit", PathApiV1AdminTokensManualCredit())
    MapSet(result, "/api/v1/admin/tokens/checkpoint", PathApiV1AdminTokensCheckpoint())
    MapSet(result, "/api/v1/apps", PathApiV1Apps())
    MapSet(result, "/api/v1/apps/register-signed", PathApiV1AppsRegisterSigned())
    MapSet(result, "/api/v1/apps/{app_id}", PathApiV1AppsAppId())
