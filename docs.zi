    MapInit(resultGetResponses)
    resultGetResponses200: Map(string, Any)
    MapInit(resultGetResponses200)
    MapSet(resultGetResponses200, "description", "Server is healthy")
    MapSet(resultGetResponses, "200", resultGetResponses200)
