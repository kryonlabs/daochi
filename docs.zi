SignedHeaderParameters :: () -> []Map(string, Any) {
    result := AllocateObjects(cast(isize)2)
    resultItem0: Map(string, Any)
    MapInit(resultItem0)
    MapSet(resultItem0, "name", "X-Daochi-User")
    MapSet(resultItem0, "in", "header")
    MapSet(resultItem0, "required", true)
    MapSet(resultItem0, "description", "SHA-256 hash of the ML-DSA-44 public key. Legacy X-Ksync-User and X-Inbe-User are also accepted.")
    resultItem0Schema: Map(string, Any)
    MapInit(resultItem0Schema)
    MapSet(resultItem0Schema, "type", "string")
    MapSet(resultItem0Schema, "pattern", "^[0-9a-f]{64}$")
    MapSet(resultItem0, "schema", resultItem0Schema)
    result[0] = resultItem0
    resultItem1: Map(string, Any)
    MapInit(resultItem1)
    MapSet(resultItem1, "name", "X-Daochi-Signature")
    MapSet(resultItem1, "in", "header")
    MapSet(resultItem1, "required", true)
    MapSet(resultItem1, "description", "ML-DSA-44 signature as hex or base64. Legacy X-Ksync-Signature and X-Inbe-Signature are also accepted.")
    resultItem1Schema: Map(string, Any)
    MapInit(resultItem1Schema)
    MapSet(resultItem1Schema, "type", "string")
    MapSet(resultItem1, "schema", resultItem1Schema)
    result[1] = resultItem1
    return result
}

SyncHeaderParameters :: () -> []Map(string, Any) {
    result := AllocateObjects(cast(isize)5)
    resultItem0: Map(string, Any)
    MapInit(resultItem0)
    MapSet(resultItem0, "name", "Authorization")
    MapSet(resultItem0, "in", "header")
    MapSet(resultItem0, "required", true)
    MapSet(resultItem0, "description", "Bearer auth token returned by POST /api/v1/sync/login.")
    resultItem0Schema: Map(string, Any)
    MapInit(resultItem0Schema)
    MapSet(resultItem0Schema, "type", "string")
    MapSet(resultItem0, "schema", resultItem0Schema)
    result[0] = resultItem0
    resultItem1: Map(string, Any)
    MapInit(resultItem1)
    MapSet(resultItem1, "name", "X-Daochi-User")
    MapSet(resultItem1, "in", "header")
    MapSet(resultItem1, "required", true)
    MapSet(resultItem1, "description", "SHA-256 hash of the ML-DSA-44 public key. Legacy X-Ksync-User and X-Inbe-User are also accepted.")
    resultItem1Schema: Map(string, Any)
    MapInit(resultItem1Schema)
    MapSet(resultItem1Schema, "type", "string")
    MapSet(resultItem1Schema, "pattern", "^[0-9a-f]{64}$")
    MapSet(resultItem1, "schema", resultItem1Schema)
    result[1] = resultItem1
    resultItem2: Map(string, Any)
    MapInit(resultItem2)
    MapSet(resultItem2, "name", "X-Daochi-Client")
    MapSet(resultItem2, "in", "header")
    MapSet(resultItem2, "required", false)
    MapSet(resultItem2, "description", "Optional client ID for encrypted envelope metadata. X-Ksync-Client remains accepted.")
    resultItem2Schema: Map(string, Any)
    MapInit(resultItem2Schema)
    MapSet(resultItem2Schema, "type", "string")
    MapSet(resultItem2, "schema", resultItem2Schema)
    result[2] = resultItem2
    resultItem3: Map(string, Any)
    MapInit(resultItem3)
    MapSet(resultItem3, "name", "X-Daochi-Since-Version")
    MapSet(resultItem3, "in", "header")
    MapSet(resultItem3, "required", false)
    MapSet(resultItem3, "description", "Optional last-seen server version for encrypted envelope delta reads. X-Ksync-Since-Version remains accepted.")
    resultItem3Schema: Map(string, Any)
    MapInit(resultItem3Schema)
    MapSet(resultItem3Schema, "type", "integer")
    MapSet(resultItem3, "schema", resultItem3Schema)
    result[3] = resultItem3
    resultItem4: Map(string, Any)
    MapInit(resultItem4)
    MapSet(resultItem4, "name", "X-Daochi-Limit")
    MapSet(resultItem4, "in", "header")
    MapSet(resultItem4, "required", false)
    MapSet(resultItem4, "description", "Optional encrypted envelope page size. X-Ksync-Limit remains accepted. The server may clamp this with DAOCHI_ENCRYPTED_PAYLOAD_MAX_RETURN.")
    resultItem4Schema: Map(string, Any)
    MapInit(resultItem4Schema)
    MapSet(resultItem4Schema, "type", "integer")
    MapSet(resultItem4, "schema", resultItem4Schema)
    result[4] = resultItem4
    return result
}

