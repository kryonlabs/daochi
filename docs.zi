    MapSet(result, "/api/v1/friends/requests/{request_id}/accept", PathApiV1FriendsRequestsRequestIdAccept())
    MapSet(result, "/api/v1/friends/requests/{request_id}/decline", PathApiV1FriendsRequestsRequestIdDecline())
    MapSet(result, "/api/v1/profile/stats", PathApiV1ProfileStats())
    MapSet(result, "/api/v1/friends/stats", PathApiV1FriendsStats())
