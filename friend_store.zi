#import "protocol"
#import "sync_types"
#import "std/go_types"
ctx :: #import "std/context_go";
sql :: #import "std/sql_go";
errors :: #import "std/errors_go";
clock :: #import "std/time_go";
json :: #import "std/json_go";
timestamp :: #import "timestamp";
state :: #import "account_state";
strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

FriendRequestResult :: struct {
    value: FriendRequest
    found: bool
    error: Error
}
FriendRequestsResult :: struct {
    incoming: []FriendRequest
    outgoing: []FriendRequest
    error: Error
}
FriendsResult :: struct {
    value: []Friend
    error: Error
}
SocialResult :: struct {
    value: []SocialSnapshot
    error: Error
}
ProfileStatsResult :: struct {
    applied: isize
    error: Error
}

#scope_file
RequestListResult :: struct {
    value: []FriendRequest
    error: Error
}
UserPair :: struct {
    first: string
    second: string
}
MakeRequests :: (count: isize) -> []FriendRequest #foreign builtin "make";
AppendRequest :: (values: []FriendRequest, value: FriendRequest) -> []FriendRequest #foreign builtin "append";
MakeFriends :: (count: isize) -> []Friend #foreign builtin "make";
AppendFriend :: (values: []Friend, value: Friend) -> []Friend #foreign builtin "append";
MakeSnapshots :: (count: isize) -> []SocialSnapshot #foreign builtin "make";
TrimSpace :: (value: string) -> string #foreign strings;
Join :: (values: []string, separator: string) -> string #foreign strings;
Compare :: (first: string, second: string) -> isize #foreign strings;

RequestSQL :: #string SQL
SELECT fr.id,fr.requester_user_id_hash,COALESCE(ru.alias,''),fr.target_user_id_hash,COALESCE(tu.alias,''),fr.status,fr.created_at,fr.updated_at
FROM server_friend_requests fr
JOIN server_users ru ON ru.user_id_hash=fr.requester_user_id_hash
JOIN server_users tu ON tu.user_id_hash=fr.target_user_id_hash
SQL;

Pair :: (first: string, second: string) -> UserPair {
    result: UserPair
    result.first = first
    result.second = second
    if Compare(second, first) < cast(isize)0 {
        result.first = second
        result.second = first
    }
    return result
}

Failure :: (error: Error) -> FriendRequestResult {
    result: FriendRequestResult
    result.error = error
    return result
}

Destinations :: (request: *FriendRequest) -> [8]Any {
    values: [8]Any
    values[0] = *request.ID
    values[1] = *request.RequesterUserID
    values[2] = *request.RequesterAlias
    values[3] = *request.TargetUserID
    values[4] = *request.TargetAlias
    values[5] = *request.Status
    values[6] = *request.CreatedAt
    values[7] = *request.UpdatedAt
    return values
}

ReadRequest :: (row: *sql.Row) -> FriendRequestResult {
    result: FriendRequestResult
    destinations := Destinations(*result.value)
    result.error = sql.ScanRow(row, destinations[:])
    result.found = result.error == null
    return result
}

RequestByUsers :: (database: *sql.Database, context: ctx.Context,
    requester: string, target: string) -> FriendRequestResult {
    parts: [2]string
    parts[0] = RequestSQL
    parts[1] = "\nWHERE fr.requester_user_id_hash=?1 AND fr.target_user_id_hash=?2"
    arguments: [2]Any
    arguments[0] = requester
    arguments[1] = target
    row := sql.QueryRow(database, context, Join(parts[:], ""), arguments[:])
    return ReadRequest(row)
}

PendingRequests :: (database: *sql.Database, context: ctx.Context,
    userID: string, condition: string) -> RequestListResult {
    result: RequestListResult
    parts: [4]string
    parts[0] = RequestSQL
    parts[1] = "\nWHERE "
    parts[2] = condition
    parts[3] = " AND fr.status='pending'\nORDER BY fr.updated_at DESC"
    arguments: [1]Any
    arguments[0] = userID
    queried := sql.Query(database, context, Join(parts[:], ""), arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    defer sql.CloseRows(queried.value)
    result.value = MakeRequests(cast(isize)0)
    while sql.Next(queried.value) {
        request: FriendRequest
        destinations := Destinations(*request)
        error := sql.ScanRows(queried.value, destinations[:])
        if error != null {
            result = .{error = error}
            return result
        }
        result.value = AppendRequest(result.value, request)
    }
    result.error = sql.RowsError(queried.value)
    return result
}

#scope_export
CreateRequest :: (database: *sql.Database, context: ctx.Context, id: string,
    requester: string, target: string) -> FriendRequestResult {
    if requester == target {
        return Failure(errors.New("cannot friend self"))
    }
    pair := Pair(requester, target)
    arguments: [4]Any
    arguments[0] = pair.first
    arguments[1] = pair.second
    exists: isize
    destinations: [1]Any
    destinations[0] = *exists
    row := sql.QueryRow(database, context,
        "SELECT EXISTS(SELECT 1 FROM server_friendships WHERE user_id_a=?1 AND user_id_b=?2)", arguments[0:2])
    error := sql.ScanRow(row, destinations[:])
    if error != null {
        return Failure(error)
    }
    if exists != cast(isize)0 {
        return Failure(errors.New("already friends"))
    }
    arguments[0] = id
    arguments[1] = requester
    arguments[2] = target
    arguments[3] = clock.Format(clock.UTC(clock.Now()), "2006-01-02T15:04:05Z07:00")
    query := #string SQL
INSERT INTO server_friend_requests(id,requester_user_id_hash,target_user_id_hash,status,created_at,updated_at)
VALUES(?1,?2,?3,'pending',?4,?4)
ON CONFLICT(requester_user_id_hash,target_user_id_hash) DO UPDATE SET
    status=CASE WHEN server_friend_requests.status='declined' THEN 'pending' ELSE server_friend_requests.status END,
    updated_at=CASE WHEN server_friend_requests.status='declined' THEN excluded.updated_at ELSE server_friend_requests.updated_at END
SQL;
    written := sql.Exec(database, context, query, arguments[:])
    if written.error != null {
        return Failure(written.error)
    }
    return RequestByUsers(database, context, requester, target)
}

Request :: (database: *sql.Database, context: ctx.Context, id: string) -> FriendRequestResult {
    parts: [2]string
    parts[0] = RequestSQL
    parts[1] = "\nWHERE fr.id=?1"
    arguments: [1]Any
    arguments[0] = id
    row := sql.QueryRow(database, context, Join(parts[:], ""), arguments[:])
    result := ReadRequest(row)
    if errors.Is(result.error, sql.NoRows()) {
        result = .{}
    }
    return result
}

Requests :: (database: *sql.Database, context: ctx.Context, userID: string) -> FriendRequestsResult {
    result: FriendRequestsResult
    incoming := PendingRequests(database, context, userID, "fr.target_user_id_hash=?1")
    result.error = incoming.error
    if result.error != null {
        return result
    }
    result.incoming = incoming.value
    outgoing := PendingRequests(database, context, userID, "fr.requester_user_id_hash=?1")
    result.outgoing = outgoing.value
    result.error = outgoing.error
    return result
}

Accept :: (database: *sql.Database, context: ctx.Context, userID: string,
    id: string, missingUser: Error) -> FriendRequestResult {
    opened := sql.Begin(database, context, null)
    if opened.error != null {
        return Failure(opened.error)
    }
    defer sql.Rollback(opened.value)
    parts: [2]string
    parts[0] = RequestSQL
    parts[1] = "\nWHERE fr.id=?1"
    arguments: [3]Any
    arguments[0] = id
    row := sql.QueryRowTx(opened.value, context, Join(parts[:], ""), arguments[0:1])
    result := ReadRequest(row)
    if result.error != null {
        return Failure(result.error)
    }
    if result.value.TargetUserID != userID {
        return Failure(missingUser)
    }
    if result.value.Status != "pending" {
        return Failure(errors.New("request not pending"))
    }
    pair := Pair(result.value.RequesterUserID, result.value.TargetUserID)
    now := clock.Format(clock.UTC(clock.Now()), "2006-01-02T15:04:05Z07:00")
    arguments[1] = now
    updated := sql.ExecTx(opened.value, context,
        "UPDATE server_friend_requests SET status='accepted',updated_at=?2 WHERE id=?1", arguments[0:2])
    if updated.error != null {
        return Failure(updated.error)
    }
    arguments[0] = pair.first
    arguments[1] = pair.second
    arguments[2] = now
    inserted := sql.ExecTx(opened.value, context,
        "INSERT OR IGNORE INTO server_friendships(user_id_a,user_id_b,created_at) VALUES(?1,?2,?3)", arguments[:])
    if inserted.error != null {
        return Failure(inserted.error)
    }
    result.error = sql.Commit(opened.value)
    if result.error != null {
        return Failure(result.error)
    }
    result.value.Status = "accepted"
    result.value.UpdatedAt = now
    return result
}

Decline :: (database: *sql.Database, context: ctx.Context, userID: string,
    id: string, missingUser: Error) -> FriendRequestResult {
    result := Request(database, context, id)
    if result.error != null {
        return Failure(result.error)
    }
    if !result.found {
        return Failure(sql.NoRows())
    }
    if result.value.TargetUserID != userID && result.value.RequesterUserID != userID {
        return Failure(missingUser)
    }
    if result.value.Status != "pending" {
        return Failure(errors.New("request not pending"))
    }
    now := clock.Format(clock.UTC(clock.Now()), "2006-01-02T15:04:05Z07:00")
    arguments: [2]Any
    arguments[0] = id
    arguments[1] = now
    updated := sql.Exec(database, context,
        "UPDATE server_friend_requests SET status='declined',updated_at=?2 WHERE id=?1", arguments[:])
    if updated.error != null {
        return Failure(updated.error)
    }
    result.value.Status = "declined"
    result.value.UpdatedAt = now
    return result
}

Friends :: (database: *sql.Database, context: ctx.Context, userID: string) -> FriendsResult {
    result: FriendsResult
    arguments: [1]Any
    arguments[0] = userID
    query := #string SQL
SELECT u.user_id_hash,COALESCE(u.alias,''),u.profile_icon,f.created_at
FROM server_friendships f
JOIN server_users u ON u.user_id_hash=CASE WHEN f.user_id_a=?1 THEN f.user_id_b ELSE f.user_id_a END
WHERE f.user_id_a=?1 OR f.user_id_b=?1
ORDER BY COALESCE(u.alias,u.user_id_hash),u.user_id_hash
SQL;
    queried := sql.Query(database, context, query, arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    defer sql.CloseRows(queried.value)
    result.value = MakeFriends(cast(isize)0)
    while sql.Next(queried.value) {
        friend: Friend
        destinations: [4]Any
        destinations[0] = *friend.UserIDHash
        destinations[1] = *friend.Alias
        destinations[2] = *friend.ProfileIcon
        destinations[3] = *friend.CreatedAt
        error := sql.ScanRows(queried.value, destinations[:])
        if error != null {
            result = .{error = error}
            return result
        }
        result.value = AppendFriend(result.value, friend)
    }
    result.error = sql.RowsError(queried.value)
    return result
}

Authoritative :: (database: *sql.Database, context: ctx.Context, userID: string) -> SocialResult {
    result: SocialResult
    friends := Friends(database, context, userID)
    result.error = friends.error
    if result.error != null {
        return result
    }
    requests := Requests(database, context, userID)
    result.error = requests.error
    if result.error != null {
        return result
    }
    friendsResponse: FriendsResponse
    friendsResponse.Friends = friends.value
    friendsJSON := json.Marshal(friendsResponse)
    result.error = friendsJSON.error
    if result.error != null {
        return result
    }
    requestsResponse: FriendRequestsResponse
    requestsResponse.Incoming = requests.incoming
    requestsResponse.Outgoing = requests.outgoing
    requestsJSON := json.Marshal(requestsResponse)
    result.error = requestsJSON.error
    if result.error != null {
        return result
    }
    now := timestamp.CanonicalNow()
    result.value = MakeSnapshots(cast(isize)2)
    result.value[0].Kind = "friends.list"
    result.value[0].JSON = cast(RawMessage)friendsJSON.value
    result.value[0].UpdatedAt = now
    result.value[1].Kind = "friends.requests"
    result.value[1].JSON = cast(RawMessage)requestsJSON.value
    result.value[1].UpdatedAt = now
    return result
}

Remove :: (database: *sql.Database, context: ctx.Context, userID: string, friendID: string) -> Error {
    pair := Pair(userID, friendID)
    opened := sql.Begin(database, context, null)
    if opened.error != null {
        return opened.error
    }
    defer sql.Rollback(opened.value)
    arguments: [2]Any
    arguments[0] = pair.first
    arguments[1] = pair.second
    removed := sql.ExecTx(opened.value, context,
        "DELETE FROM server_friendships WHERE user_id_a=?1 AND user_id_b=?2", arguments[:])
    if removed.error != null {
        return removed.error
    }
    arguments[0] = userID
    arguments[1] = friendID
    removed = sql.ExecTx(opened.value, context,
        "DELETE FROM server_friend_requests WHERE (requester_user_id_hash=?1 AND target_user_id_hash=?2) OR (requester_user_id_hash=?2 AND target_user_id_hash=?1)",
        arguments[:])
    if removed.error != null {
        return removed.error
    }
    return sql.Commit(opened.value)
}

UpsertStats :: (database: *sql.Database, context: ctx.Context, userID: string,
    app: string, metrics: []ProfileMetric) -> ProfileStatsResult {
    result: ProfileStatsResult
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    defer sql.Rollback(opened.value)
    now := clock.Format(clock.UTC(clock.Now()), "2006-01-02T15:04:05Z07:00")
    query := #string SQL
INSERT INTO server_profile_stats(user_id_hash,app,practice,metric,value,label,local_date,updated_at)
VALUES(?1,?2,?3,?4,?5,?6,?7,?8)
ON CONFLICT(user_id_hash,app,practice,metric) DO UPDATE SET
    value=excluded.value,label=excluded.label,local_date=excluded.local_date,updated_at=excluded.updated_at
WHERE excluded.value != server_profile_stats.value
   OR excluded.label != server_profile_stats.label
   OR excluded.local_date != server_profile_stats.local_date
SQL;
    arguments: [8]Any
    arguments[0] = userID
    arguments[1] = app
    arguments[7] = now
    for metric: metrics {
        practice := TrimSpace(metric.Practice)
        name := TrimSpace(metric.Metric)
        if practice == "" || name == "" {
            continue
        }
        arguments[2] = practice
        arguments[3] = name
        arguments[4] = metric.Value
        arguments[5] = metric.Label
        arguments[6] = metric.LocalDate
        written := sql.ExecTx(opened.value, context, query, arguments[:])
        if written.error != null {
            result.applied = cast(isize)0
            result.error = written.error
            return result
        }
        result.applied += state.Affected(written.value)
    }
    result.error = sql.Commit(opened.value)
    return result
}
