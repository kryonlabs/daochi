#import "go_types"
http :: #import "http_go";
io :: #import "io_go";
json :: #import "json_go";
errors :: #import "errors_go";
go_io :: #system_library "go:io";

#scope_file
CloseAtReturn :: (reader: io.ReadCloser) #go_defer #foreign go_io "ReadCloser.Close";

#scope_export
ReadJSON :: (writer: http.ResponseWriter, request: *http.Request, limit: s64) -> json.JSONResult {
    result: json.JSONResult
    body := http.Body(request)
    CloseAtReturn(body)
    read := io.ReadAll(cast(io.Reader)http.MaxBytesReader(writer, body, limit))
    if read.error != null {
        result.error = errors.New("request body too large")
        return result
    }
    if !json.Valid(read.value) {
        result.error = errors.New("invalid json")
        return result
    }
    result.value = read.value
    return result
}
