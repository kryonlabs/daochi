// The Telegram menu and help share one catalogue of existing Lumi actions.
#import "std/go_types"
json :: #import "std/json_go";
text :: #import "std/text_go";
strings :: #system_library "go:strings";
Join :: (parts: []string, separator: string) -> string #foreign strings;
IndexAny :: (value: string, characters: string) -> isize #foreign strings;
Lower :: (value: string) -> string #foreign strings "ToLower";
EqualFold :: (left: string, right: string) -> bool #foreign strings;
TrimSpace :: (value: string) -> string #foreign strings;

BotCommand :: struct {
    command: string #go_tag "json:\"command\""
    description: string #go_tag "json:\"description\""
}

ParsedCommand :: struct {
    name: string
    message: string
    foreign: bool
    has_argument: bool
}

Parse :: (input: string) -> ParsedCommand {
    result := ParsedCommand.{message = input}
    if input.count == 0 || input[0] != cast(u8)47 {
        return result
    }
    boundary := IndexAny(input, " \t\r\n")
    if boundary < 0 {
        boundary = cast(isize)input.count
    }
    command := input[1:boundary]
    colon := IndexAny(command, ":")
    if colon >= 0 {
        diary_command := command[:colon]
        diary_address := IndexAny(diary_command, "@")
        if diary_address >= 0 {
            diary_command = diary_command[:diary_address]
        }
        if EqualFold(diary_command, "journal") || EqualFold(diary_command, "diary") {
            boundary = colon + 1
            command = input[1:boundary]
        }
    }
    address := IndexAny(command, "@")
    if address >= 0 {
        if !EqualFold(command[address + 1:], "inlumi_bot") {
            result.foreign = true
            return result
        }
        command = command[:address]
    }
    result.name = Lower(command)
    result.has_argument = TrimSpace(input[boundary:]) != ""
    // Only normalize the command. Diary content, Unicode and whitespace in
    // arguments remain exactly as supplied by the user.
    parts: [3]string = .["/", result.name, input[boundary:]]
    result.message = Join(parts[:], "")
    return result
}

Catalogue :: () -> []BotCommand {
    result: []BotCommand
    unused json.Unmarshal(text.ToBytes(Document), *result)
    return result
}

Known :: (command: string) -> bool {
    for item: Catalogue() {
        if item.command == command {
            return true
        }
    }
    // Existing app aliases remain accepted without cluttering the menu.
    return command == "suggest" || command == "theme" || command == "appearance" ||
        command == "settings" || command == "light" || command == "dark" || command == "system"
}

Usage :: (command: string) -> string {
    if command == "todo" { return "/todo <task title>" }
    if command == "done" { return "/done <task title>" }
    if command == "reopen" { return "/reopen <task title>" }
    if command == "feedback" { return "/feedback <problem or suggestion>" }
    if command == "suggest" { return "/suggest <suggestion>" }
    if command == "theme" { return "/theme <theme name>" }
    return ""
}

Help :: (linked: bool) -> string {
    introduction := ifx linked then "Lumi uses your linked Inner Breeze account. Keep Inner Breeze open to receive replies and run app actions. Actions need their installed sub-app. You can also chat normally.\n\n" else "Open Inner Breeze, sign in, and choose Chat on Telegram in Lumi to link this private chat. Keep your private key inside the app.\n\n"
    output := introduction
    for item: Catalogue() {
        parts: [6]string = .[output, "/", item.command, " — ", item.description, "\n"]
        output = Join(parts[:], "")
    }
    examples: [2]string = .[output, "\nExamples:\n/todo Buy tea\n/done Buy tea\n/habit Drink water\n/journal A calm morning\n/progress meditation 7\n/feedback Describe a problem (asks before sending)"]
    return Join(examples[:], "")
}

Document :: #string JSON
[
  {"command":"start","description":"Connect your Inner Breeze account"},
  {"command":"help","description":"Show commands and examples"},
  {"command":"app","description":"Open Inner Breeze"},
  {"command":"history","description":"Open your full Lumi conversation in Inner Breeze"},
  {"command":"todo","description":"Add a task: /todo <title>"},
  {"command":"done","description":"Complete a task: /done <title>"},
  {"command":"reopen","description":"Reopen a completed task: /reopen <title>"},
  {"command":"lists","description":"Open your lists"},
  {"command":"habit","description":"Complete a habit: /habit <title>"},
  {"command":"habits","description":"Open your habits"},
  {"command":"journal","description":"Write to today's diary: /journal <text>"},
  {"command":"diary","description":"Open your diary"},
  {"command":"meditate","description":"Start meditation in Inner Breeze"},
  {"command":"whm","description":"Start Wim Hof breathing in Inner Breeze"},
  {"command":"practices","description":"Open your practices"},
  {"command":"progress","description":"Show a chart: /progress <sessions|meditation|retention|habits> [1–31 days]"},
  {"command":"feedback","description":"Draft feedback for your approval: /feedback <text>"},
  {"command":"donate","description":"Show official donation links"},
  {"command":"cancel","description":"Cancel a pending diary or habit choice"}
]
JSON;
