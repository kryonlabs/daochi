#import "std/go_types"
#import "std/map_go"
#import "protocol"
config :: #import "config";
ctx :: #import "std/context_go";
http :: #import "std/http_go";
io :: #import "std/io_go";
json :: #import "std/json_go";
clock :: #import "std/time_go";
errors :: #import "std/errors_go";
raw :: #import "sync_types";
url :: #import "std/url_go";
network :: #import "std/net_go";
random :: #import "std/random_go";
text :: #import "std/text_go";
sorting :: #system_library "go:sort";
go_http :: #system_library "go:net/http";
go_io :: #system_library "go:io";
numbers :: #system_library "go:strconv";
strings :: #system_library "go:strings";
format :: #system_library "go:fmt";
go_url :: #system_library "go:net/url";
big :: #system_library "go:math/big";
md5 :: #system_library "go:crypto/md5";
hex :: #system_library "go:encoding/hex";
builtin :: #system_library "go:builtin";

WalletSubaddress :: struct {
    Major: isize #go_tag "json:\"major\""
    Minor: isize #go_tag "json:\"minor\""
}

WalletTransfer :: struct {
    TxID: string #go_tag "json:\"txid\""
    Amount: s64 #go_tag "json:\"amount\""
    Confirmations: s64 #go_tag "json:\"confirmations\""
    Height: s64 #go_tag "json:\"height\""
    UnlockTime: s64 #go_tag "json:\"unlock_time\""
    Locked: bool #go_tag "json:\"locked\""
    DoubleSpendSeen: bool #go_tag "json:\"double_spend_seen\""
    SubaddrIndex: WalletSubaddress #go_tag "json:\"subaddr_index\""
}

InvoicePaymentState :: struct {
    PaymentID: string
    SeenAtomic: s64
    ConfirmedAtomic: s64
}

InvoicePaymentResult :: struct {
    value: InvoicePaymentState
    error: Error
}

WalletAddressResult :: struct {
    address: string
    index: isize
    error: Error
}

TokenUnitsResult :: struct {
    value: s64
    error: Error
}

#scope_file
RPCError :: struct {
    #go_anonymous
    code: isize #go_tag "json:\"code\""
    message: string #go_tag "json:\"message\""
}
RPCResponse :: struct {
    #go_anonymous
    result: raw.RawMessage #go_tag "json:\"result\""
    error: *RPCError #go_tag "json:\"error\""
}
RPCAddress :: struct {
    #go_anonymous
    address: string #go_tag "json:\"address\""
    addressIndex: isize #go_tag "json:\"address_index\""
}
DigestChallenge :: struct {
    realm: string
    nonce: string
    qop: string
    algorithm: string
}
DigestAuthorizationResult :: struct {
    value: string
    error: Error
}
InvoiceTransfers :: struct {
    #go_anonymous
    incoming: []WalletTransfer #go_tag "json:\"in\""
    pool: []WalletTransfer #go_tag "json:\"pool\""
}
BigInteger :: #type #foreign big "Int";
NewInteger :: (value: s64) -> *BigInteger #foreign big "NewInt";
Multiply :: (result: *BigInteger, left: *BigInteger, right: *BigInteger) -> *BigInteger #foreign big "(*Int).Mul";
Divide :: (result: *BigInteger, left: *BigInteger, right: *BigInteger) -> *BigInteger #foreign big "(*Int).Div";
FitsInteger :: (value: *BigInteger) -> bool #foreign big "(*Int).IsInt64";
IntegerValue :: (value: *BigInteger) -> s64 #foreign big "(*Int).Int64";
SetBasicAuth :: (request: *http.Request, user: string, password: string) #foreign go_http "(*Request).SetBasicAuth";
HeaderValues :: (header: http.Header, name: string) -> []string #foreign go_http "Header.Values";
CloseAtReturn :: (body: io.ReadCloser) #go_defer #foreign go_io "ReadCloser.Close";
StatusError :: (message: string, status: isize) -> Error #foreign format "Errorf";
RPCMessageError :: (message: string, detail: string) -> Error #foreign format "Errorf";
RedirectPolicy :: #type (request: *http.Request, previous: []*http.Request) -> Error;
SetRedirect :: (client: *http.Client, policy: RedirectPolicy) #go_field #foreign go_http "(*Client).CheckRedirect";
LastResponse :: () -> Error #go_field #foreign go_http "ErrUseLastResponse";

RejectRedirect :: (request: *http.Request, previous: []*http.Request) -> Error {
    return LastResponse()
}

ResponseHeaders :: (response: *http.Response) -> http.Header #go_field #foreign go_http "(*Response).Header";
RequestURI :: (target: *url.URL) -> string #foreign go_url "(*URL).RequestURI";
FormatPair :: (pattern: string, first: string, second: string) -> string #foreign format "Sprintf";
FormatTriple :: (pattern: string, first: string, second: string, third: string) -> string #foreign format "Sprintf";
FormatSix :: (pattern: string, first: string, second: string, third: string,
    fourth: string, fifth: string, sixth: string) -> string #foreign format "Sprintf";
FormatEight :: (pattern: string, first: string, second: string, third: string, fourth: string,
    fifth: string, sixth: string, seventh: string, eighth: string) -> string #foreign format "Sprintf";
SplitRaw :: (value: string, separator: string) -> []string #foreign strings "Split";
TrimRaw :: (value: string) -> string #foreign strings "TrimSpace";
LowerRaw :: (value: string) -> string #foreign strings "ToLower";
HasPrefix :: (value: string, prefix: string) -> bool #foreign strings;
SumMD5 :: (value: []u8) -> [16]u8 #foreign md5 "Sum";
EncodeHex :: (value: []u8) -> string #foreign hex "EncodeToString";
AllocateText :: (count: isize) -> []string #foreign builtin "make";
AppendText :: (values: []string, value: string) -> []string #foreign builtin "append";
IntegerText :: (value: isize) -> string #foreign numbers "Itoa";
Join :: (values: []string, separator: string) -> string #foreign strings;
SortStrings :: (values: []string) #foreign sorting "Strings";

SplitText :: (value: string, separator: string) -> []string {
    return SplitRaw(value, separator)
}

TrimText :: (value: string) -> string {
    return TrimRaw(value)
}

ToLowerText :: (value: string) -> string {
    return LowerRaw(value)
}

RPCDigest :: (value: string) -> string {
    digest := SumMD5(text.ToBytes(value))
    return EncodeHex(digest[:])
}

SafeCredentialText :: (value: string) -> bool {
    for index: cast(s64)0..value.count - 1 {
        byte := value[index]
        if byte < cast(u8)32 || byte == cast(u8)127 || byte == cast(u8)34 || byte == cast(u8)92 {
            return false
        }
    }
    return true
}

ChallengeValue :: (challenge: string, name: string) -> string {
    fields := SplitText(challenge, ",")
    prefixParts: [2]string
    prefixParts[0] = name
    prefixParts[1] = "="
    prefix := Join(prefixParts[:], "")
    for field: fields {
        value := TrimText(field)
        if !HasPrefix(value, prefix) {
            continue
        }
        value = TrimText(value[prefix.count:])
        if value.count >= cast(s64)2 && value[0] == cast(u8)34 && value[value.count - 1] == cast(u8)34 {
            value = value[1:value.count - 1]
        }
        return value
    }
    return ""
}

ParseDigestChallenge :: (headers: http.Header) -> DigestChallenge {
    values := HeaderValues(headers, "WWW-Authenticate")
    challenge: DigestChallenge
    for value: values {
        if !HasPrefix(ToLowerText(value), "digest ") {
            continue
        }
        value = value[7:]
        challenge.realm = ChallengeValue(value, "realm")
        challenge.nonce = ChallengeValue(value, "nonce")
        challenge.qop = ChallengeValue(value, "qop")
        challenge.algorithm = ChallengeValue(value, "algorithm")
        return challenge
    }
    return challenge
}

DigestAuthorization :: (challenge: DigestChallenge, method: string, target: string,
    user: string, password: string) -> DigestAuthorizationResult {
    result: DigestAuthorizationResult
    if challenge.realm == "" || challenge.nonce == "" ||
        (challenge.algorithm != "" && challenge.algorithm != "MD5") ||
        (challenge.qop != "" && challenge.qop != "auth") ||
        !SafeCredentialText(challenge.realm) || !SafeCredentialText(challenge.nonce) {
        result.error = errors.New("monero rpc digest challenge invalid")
        return result
    }
    clientNonceBytes: [16]u8
    filled := random.Fill(clientNonceBytes[:])
    if filled.error != null {
        result.error = filled.error
        return result
    }
    clientNonce := EncodeHex(clientNonceBytes[:])
    ha1 := RPCDigest(FormatTriple("%s:%s:%s", user, challenge.realm, password))
    ha2 := RPCDigest(FormatPair("%s:%s", method, target))
    response := RPCDigest(FormatSix("%s:%s:%s:%s:%s:%s", ha1, challenge.nonce, "00000001", clientNonce, "auth", ha2))
    result.value = FormatSix(
        "Digest username=\"%s\",realm=\"%s\",nonce=\"%s\",uri=\"%s\",algorithm=MD5,qop=auth,nc=00000001,cnonce=\"%s\",response=\"%s\"",
        user, challenge.realm, challenge.nonce, target, clientNonce, response)
    return result
}

CollectTransfers :: (state: *InvoicePaymentState, seen: Map(string, bool), identifiers: []string,
    transfers: []WalletTransfer, configuration: config.Config, invoice: MoneroInvoiceResponse) -> []string {
    for transfer: transfers {
        if transfer.TxID == "" || transfer.Amount <= 0 ||
            transfer.SubaddrIndex.Major != 0 || transfer.SubaddrIndex.Minor != invoice.AddressIndex {
            continue
        }
        if MapGet(seen, transfer.TxID) {
            continue
        }
        MapSet(seen, transfer.TxID, true)
        state.SeenAtomic += transfer.Amount
        identifiers = AppendText(identifiers, transfer.TxID)
        if transfer.DoubleSpendSeen {
            continue
        }
        if transfer.Confirmations >= ConfirmationsRequired(configuration) &&
            !transfer.Locked && transfer.UnlockTime == 0 {
            state.ConfirmedAtomic += transfer.Amount
        }
    }
    return identifiers
}

#scope_export
ValidRate :: (configuration: config.Config) -> bool {
    return configuration.MoneroRateAtomicAmount > 0 && configuration.MoneroRateTokenUnits > 0
}

ConfirmationsRequired :: (configuration: config.Config) -> s64 {
    if configuration.MoneroConfirmationsRequired > 0 {
        return configuration.MoneroConfirmationsRequired
    }
    return 10
}

FinalityConfirmations :: (configuration: config.Config) -> s64 {
    required := ConfirmationsRequired(configuration)
    if required > cast(s64)9223372036854775807 - cast(s64)60 {
        return cast(s64)9223372036854775807
    }
    return required + cast(s64)60
}

ValidateRPCConfiguration :: (configuration: config.Config) -> Error {
    target := TrimText(configuration.MoneroWalletRPCURL)
    if target == "" {
        return errors.New("monero rpc url required")
    }
    parsed := url.Parse(target)
    if parsed.error != null {
        return errors.New("monero rpc url invalid")
    }
    scheme := ToLowerText(url.Scheme(parsed.value))
    if scheme != "http" && scheme != "https" {
        return errors.New("monero rpc transport invalid")
    }
    host := url.Host(parsed.value)
    split := network.SplitHostPort(host)
    if split.error == null {
        host = split.host
    }
    ip := network.ParseIP(host)
    loopback := network.ValidIP(ip) && network.IsLoopback(ip)
    if !loopback && scheme != "https" {
        return errors.New("monero rpc transport invalid")
    }
    if (configuration.MoneroWalletRPCUser == "") != (configuration.MoneroWalletRPCPassword == "") {
        return errors.New("monero rpc credentials incomplete")
    }
    if configuration.MoneroWalletRPCUser != "" &&
        (!SafeCredentialText(configuration.MoneroWalletRPCUser) ||
        !SafeCredentialText(configuration.MoneroWalletRPCPassword)) {
        return errors.New("monero rpc credentials invalid")
    }
    return null
}

MinimumAtomicAmount :: (configuration: config.Config) -> s64 {
    if configuration.MoneroMinimumAtomicAmount > 0 {
        return configuration.MoneroMinimumAtomicAmount
    }
    return 1
}

TokenUnits :: (amount: s64, rateAtomic: s64, rateTokens: s64) -> TokenUnitsResult {
    result: TokenUnitsResult
    if amount <= 0 || rateAtomic <= 0 || rateTokens <= 0 {
        result.error = errors.New("invalid monero conversion")
        return result
    }
    value := NewInteger(0)
    Multiply(value, NewInteger(amount), NewInteger(rateTokens))
    Divide(value, value, NewInteger(rateAtomic))
    if !FitsInteger(value) {
        result.error = errors.New("monero conversion overflow")
        return result
    }
    result.value = IntegerValue(value)
    return result
}

// The Monero atomic units that buy units Dew units at rateAtomic per rateTokens,
// rounded up to the smallest amount that funds all of them.
AtomicAmount :: (units: s64, rateAtomic: s64, rateTokens: s64) -> TokenUnitsResult {
    result := TokenUnits(units, rateTokens, rateAtomic)
    if result.error != null {
        return result
    }
    credited: TokenUnitsResult
    if result.value > 0 {
        credited = TokenUnits(result.value, rateAtomic, rateTokens)
        if credited.error != null {
            return credited
        }
    }
    if credited.value < units {
        if result.value == 9223372036854775807 {
            result.error = errors.New("monero price overflow")
            return result
        }
        result.value += 1
    }
    return result
}

Request :: (context: ctx.Context, configuration: config.Config, method: string,
    parameters: Map(string, Any), output: Any, unavailable: Error) -> Error {
    trustError := ValidateRPCConfiguration(configuration)
    if trustError != null {
        return trustError
    }
    envelope: Map(string, Any)
    MapInit(envelope)
    MapSet(envelope, "jsonrpc", "2.0")
    MapSet(envelope, "id", "0")
    MapSet(envelope, "method", method)
    MapSet(envelope, "params", parameters)
    body := json.Marshal(envelope)
    target: [2]string
    target[0] = TrimText(configuration.MoneroWalletRPCURL)
    target[1] = "/json_rpc"
    request := http.NewRequest(context, "POST", Join(target[:], ""), io.FromBytes(body.value))
    if request.error != null {
        return request.error
    }
    http.SetHeader(http.Headers(request.value), "Content-Type", "application/json")
    if configuration.MoneroWalletRPCUser != "" || configuration.MoneroWalletRPCPassword != "" {
        SetBasicAuth(request.value, configuration.MoneroWalletRPCUser, configuration.MoneroWalletRPCPassword)
    }
    client := http.NewClient(cast(clock.Duration)15000000000)
    SetRedirect(client, RejectRedirect)
    response := http.Do(client, request.value)
    if response.error != null {
        return unavailable
    }
    stream := http.ResponseBody(response.value)
    CloseAtReturn(stream)
    bytes := io.ReadAll(io.LimitReader(cast(io.Reader)stream, 1048576))
    status := http.StatusCode(response.value)
    if status < 200 || status >= 300 {
        if status == cast(isize)401 && configuration.MoneroWalletRPCUser != "" &&
            configuration.MoneroWalletRPCPassword != "" {
            challenge := ParseDigestChallenge(ResponseHeaders(response.value))
            if challenge.realm != "" || challenge.nonce != "" {
                authorization := DigestAuthorization(challenge, "POST", RequestURI(http.RequestURL(request.value)),
                    configuration.MoneroWalletRPCUser, configuration.MoneroWalletRPCPassword)
                if authorization.error != null {
                    return authorization.error
                }
                retry := http.NewRequest(context, "POST", Join(target[:], ""), io.FromBytes(body.value))
                if retry.error != null {
                    return retry.error
                }
                http.SetHeader(http.Headers(retry.value), "Content-Type", "application/json")
                SetBasicAuth(retry.value, configuration.MoneroWalletRPCUser, configuration.MoneroWalletRPCPassword)
                http.SetHeader(http.Headers(retry.value), "Authorization", authorization.value)
                retryResponse := http.Do(client, retry.value)
                if retryResponse.error != null {
                    return unavailable
                }
                retryStream := http.ResponseBody(retryResponse.value)
                CloseAtReturn(retryStream)
                retryBytes := io.ReadAll(io.LimitReader(cast(io.Reader)retryStream, 1048576))
                bytes = retryBytes
                response = retryResponse
                stream = retryStream
                status = http.StatusCode(retryResponse.value)
            }
        }
    }
    if status < 200 || status >= 300 {
        return StatusError("monero rpc status %d", status)
    }
    wrapper: RPCResponse
    decoded := json.Unmarshal(bytes.value, *wrapper)
    if decoded != null {
        return decoded
    }
    if wrapper.error != null {
        return RPCMessageError("monero rpc error: %s", wrapper.error.message)
    }
    return json.Unmarshal(cast([]u8)wrapper.result, output)
}

CreateAddress :: (context: ctx.Context, configuration: config.Config, label: string, unavailable: Error) -> WalletAddressResult {
    result: WalletAddressResult
    if configuration.MoneroWalletRPCURL == "" {
        result.error = unavailable
        return result
    }
    parameters: Map(string, Any)
    MapInit(parameters)
    MapSet(parameters, "account_index", cast(isize)0)
    MapSet(parameters, "label", label)
    address: RPCAddress
    result.error = Request(context, configuration, "create_address", parameters, *address, unavailable)
    if result.error != null {
        return result
    }
    if address.address == "" {
        result.error = errors.New("monero rpc missing address")
        return result
    }
    result.address = address.address
    result.index = address.addressIndex
    return result
}

InspectInvoice :: (context: ctx.Context, configuration: config.Config, invoice: MoneroInvoiceResponse,
    unavailable: Error) -> InvoicePaymentResult {
    result: InvoicePaymentResult
    if configuration.MoneroWalletRPCURL == "" {
        result.error = unavailable
        return result
    }
    parameters: Map(string, Any)
    MapInit(parameters)
    MapSet(parameters, "in", true)
    MapSet(parameters, "pending", true)
    MapSet(parameters, "pool", true)
    MapSet(parameters, "failed", false)
    MapSet(parameters, "account_index", cast(isize)0)
    indices: [1]isize
    indices[0] = invoice.AddressIndex
    MapSet(parameters, "subaddr_indices", indices[:])
    transfers: InvoiceTransfers
    result.error = Request(context, configuration, "get_transfers", parameters, *transfers, unavailable)
    if result.error != null {
        return result
    }
    seen: Map(string, bool)
    MapInit(seen)
    identifiers := AllocateText(cast(isize)0)
    state: InvoicePaymentState
    identifiers = CollectTransfers(*state, seen, identifiers, transfers.pool, configuration, invoice)
    identifiers = CollectTransfers(*state, seen, identifiers, transfers.incoming, configuration, invoice)
    if identifiers.count > 0 {
        SortStrings(identifiers)
        parts: [3]string
        parts[0] = Join(identifiers, "+")
        parts[1] = ":0:"
        parts[2] = IntegerText(invoice.AddressIndex)
        state.PaymentID = Join(parts[:], "")
    }
    result.value = state
    return result
}
