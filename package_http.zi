// A verified, immutable artifact store, with one latest release per app.
// An app that cannot run the latest release names the newest host and module
// interfaces it has and gets the newest archived release built for them. A
// staged release reaches only the devices whose bucket is below its share.
// Hosts that run ZX portable executables ask with `format=zx` and get only
// `<sha>.zx` releases. Hosts released before that format ask without it and
// get only their `<sha>.zib` releases, through 2027-10-23.
// An artifact with a `<sha>.zx.product` file next to it is gated: it is
// served only at `<sha>.zx/<grant>` with an unexpired grant for that product.
// Legacy `<sha>.zib` artifacts are gated the same way.
#import "std/go_types"
http :: #import "std/http_go";
url :: #import "std/url_go";
files :: #import "std/file_go";
json :: #import "std/json_go";
text :: #import "std/text_go";
keys :: #import "std/ed25519_go";
clock :: #import "std/time_go";
store :: #import "app_store";
identity :: #import "identity";
signing :: #import "signing";
response :: #import "response";
registry :: #import "app_http";
release :: #import "package_release";
grants :: #import "pack_grant";
strings :: #system_library "go:strings";
strconv :: #system_library "go:strconv";
hex :: #system_library "go:encoding/hex";
fmt :: #system_library "go:fmt";
go_http :: #system_library "go:net/http";
go_filepath :: #system_library "go:path/filepath";
go_os :: #system_library "go:os";

#scope_file
Decoded :: struct {
    value: []u8
    error: Error
}
WriteResult :: struct {
    count: isize
    error: Error
}
Number :: struct {
    value: s64
    error: Error
}
PayloadInfo :: #type #foreign go_os "FileInfo";
PayloadStatus :: struct {
    info: PayloadInfo
    error: Error
}
Interfaces :: struct {
    host: s64
    module: s64
    // The artifact suffix the host runs: ".zx", or ".zib" for hosts released
    // before the ZX format.
    format: string
    valid: bool
}
Selected :: struct {
    value: release.ReleaseV2
    found: bool
}
// The publisher's rollout of one release sequence. It is not signed: it only
// holds back a signed release, it can never select unsigned bytes.
Rollout :: struct {
    Sequence: s64 #go_tag "json:\"sequence\""
    Percent: s64 #go_tag "json:\"percent\""
    Until: s64 #go_tag "json:\"until\""
}
// The node keeps up to ten of an app's releases in its history, so a
// device on an older host still finds one built for it. The history it
// offers for going back lists at most three, the most released apps read.
HistoryRetained :: 10
HistoryOffered :: 3

// Each entry remains a publisher-signed descriptor. The index itself grants
// no trust; host interfaces and active publisher keys are checked per entry.
ReleaseHistory :: struct {
    Versions: []release.ReleaseV2 #go_tag "json:\"versions\""
}

ParseNumber :: (value: string, base: isize, bits: isize) -> Number #go_results #foreign strconv "ParseInt";
Sequence :: (sequence: s64) -> string #foreign fmt "Sprint";
TrimPrefix :: (value: string, prefix: string) -> string #foreign strings;
TrimSuffix :: (value: string, suffix: string) -> string #foreign strings;
Split :: (value: string, separator: string) -> []string #foreign strings;
Decode :: (value: string) -> Decoded #go_results #foreign hex "DecodeString";
Join :: (a: string, b: string) -> string #foreign fmt "Sprint";
Write :: (writer: http.ResponseWriter, bytes: []u8) -> WriteResult #go_results #foreign go_http "ResponseWriter.Write";
Stat :: (path: string) -> PayloadStatus #go_results #foreign go_os "Stat";
LocalPath :: (value: string) -> bool #foreign go_filepath "IsLocal";

// The release hash of a `<sha>.zx` or legacy `<sha>.zib` artifact name.
ArtifactHash :: (asset: string) -> string {
    suffixes: [2]string = .[".zx", ".zib"]
    for suffix: suffixes {
        hash := TrimSuffix(asset, suffix)
        if asset == Join(hash, suffix) && release.HashValid(hash) {
            return hash
        }
    }
    return ""
}

// Zero means the client did not name that interface and takes any release.
Interface :: (value: string) -> s64 {
    if value == "" {
        return 0
    }
    number := ParseNumber(value, cast(isize)10, cast(isize)64)
    if number.error != null || number.value < 1 || number.value > 65535 {
        return -1
    }
    return number.value
}

// Devices pick a stable bucket from 0 to 99. Apps that send none are served
// last, once a release reaches every device.
Bucket :: (request: *http.Request) -> s64 {
    value := url.Value(url.Query(http.RequestURL(request)), "bucket")
    if value == "" {
        return 99
    }
    number := ParseNumber(value, cast(isize)10, cast(isize)64)
    if number.error != null || number.value < 0 || number.value > 99 {
        return -1
    }
    return number.value
}

// A missing, unreadable or expired rollout file releases to everyone, so a
// staged release never stays held back without a publisher.
HeldBack :: (root: string, sequence: s64, bucket: s64) -> bool {
    metadata := files.ReadFile(Join(root, "rollout.json"))
    if metadata.error != null || metadata.value.count > 4096 {
        return false
    }
    rollout: Rollout
    if json.Unmarshal(metadata.value, *rollout) != null || rollout.Sequence != sequence ||
    rollout.Percent < 0 || rollout.Percent >= 100 || rollout.Until <= clock.Unix(clock.Now()) {
        return false
    }
    return bucket >= rollout.Percent
}

Wanted :: (request: *http.Request) -> Interfaces {
    query := url.Query(http.RequestURL(request))
    result: Interfaces
    result.host = Interface(url.Value(query, "host_api"))
    result.module = Interface(url.Value(query, "module_api"))
    format := url.Value(query, "format")
    result.format = ".zib"
    if format == "zx" {
        result.format = ".zx"
    }
    result.valid = result.host >= 0 && result.module >= 0 && (format == "" || format == "zx")
    return result
}

// A release is in a host's format when its module artifact is stored with
// the suffix that host runs.
InFormat :: (root: string, value: release.ReleaseV2, wanted: Interfaces) -> bool {
    for artifact: value.Artifacts {
        if artifact.Variant == "module" {
            return Stat(Join(root, Join(artifact.SHA256, wanted.format))).error == null
        }
    }
    return false
}

// A host runs releases built for its interface or an older one; module
// interfaces must match exactly.
Fits :: (value: release.ReleaseV2, wanted: Interfaces) -> bool {
    return (wanted.host == 0 || value.HostAPI <= wanted.host) &&
    (wanted.module == 0 || value.ModuleAPI == wanted.module)
}

Trusted :: (context: registry.Registry, request: *http.Request,
    value: release.ReleaseV2) -> bool {
    key := store.ActiveKey(context.database, http.Context(request), value.AppID, value.KeyID)
    public := Decode(key.value.PublicKey)
    signature := Decode(value.Signature)
    return key.error == null && key.found && key.value.Algorithm == "ed25519" &&
    (key.value.ExpiresAt <= 0 || key.value.ExpiresAt > clock.Unix(clock.Now())) &&
    public.error == null && public.value.count == 32 &&
    signature.error == null && signature.value.count == 64 &&
    keys.Verify(cast(keys.PublicKey)public.value,
        text.ToBytes(release.SigningMessage(value)), signature.value)
}

// Retained choices may have large sequence gaps. Read the bounded history
// first; older stores without it keep their bounded archive fallback.
Older :: (context: registry.Registry, request: *http.Request, root: string,
    appID: string, latest: s64, wanted: Interfaces) -> Selected {
    result: Selected
    retained := files.ReadFile(Join(root, "history-v2.json"))
    if retained.error == null {
        history: ReleaseHistory
        if retained.value.count > 262144 || json.Unmarshal(retained.value, *history) != null ||
        history.Versions.count == 0 || history.Versions.count > HistoryRetained { return result }
        previous: s64 = 9223372036854775807
        for value: history.Versions {
            if value.Sequence >= previous || !release.Valid(value, appID) { return result }
            previous = value.Sequence
        }
        for value: history.Versions {
            if value.Sequence < latest && Fits(value, wanted) && InFormat(root, value, wanted) &&
            Trusted(context, request, value) &&
            !HeldBack(root, value.Sequence, Bucket(request)) {
                result.value = value
                result.found = true
                return result
            }
        }
        return result
    }
    sequence := latest - 1
    while sequence > 0 && sequence > latest - 256 {
        metadata := files.ReadFile(Join(root, Join(Join("release-", Sequence(sequence)), ".json")))
        if metadata.error == null && metadata.value.count <= 65536 {
            value: release.ReleaseV2
            if json.Unmarshal(metadata.value, *value) == null && value.Sequence == sequence &&
            release.Valid(value, appID) && Fits(value, wanted) && InFormat(root, value, wanted) &&
            Trusted(context, request, value) {
                result.value = value
                result.found = true
                return result
            }
        }
        sequence -= 1
    }
    return result
}

History :: (context: registry.Registry, writer: http.ResponseWriter,
    request: *http.Request, root: string, appID: string) {
    wanted := Wanted(request)
    bucket := Bucket(request)
    if !wanted.valid || bucket < 0 {
        response.Error(writer, 400, "invalid interface version, format or bucket")
        return
    }
    metadata := files.ReadFile(Join(root, "history-v2.json"))
    history: ReleaseHistory
    fallback: [1]release.ReleaseV2
    if metadata.error != null {
        metadata = files.ReadFile(Join(root, "latest-v2.json"))
        if metadata.error != null || metadata.value.count > 65536 ||
        json.Unmarshal(metadata.value, *fallback[0]) != null {
            response.Error(writer, 404, "portable history unavailable")
            return
        }
        history.Versions = fallback[:]
    } else if metadata.value.count > 262144 || json.Unmarshal(metadata.value, *history) != null {
        response.Error(writer, 503, "invalid portable history")
        return
    }
    if history.Versions.count == 0 || history.Versions.count > HistoryRetained {
        response.Error(writer, 503, "invalid portable history")
        return
    }
    selected: [HistoryOffered]release.ReleaseV2
    count: s64 = 0
    previous: s64 = 9223372036854775807
    for value: history.Versions {
        if value.Sequence >= previous || !release.Valid(value, appID) {
            response.Error(writer, 503, "invalid portable history")
            return
        }
        previous = value.Sequence
        if count < HistoryOffered && Fits(value, wanted) && InFormat(root, value, wanted) &&
        Trusted(context, request, value) && !HeldBack(root, value.Sequence, bucket) {
            selected[count] = value
            count += 1
        }
    }
    http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", "no-store")
    response.JSON(writer, 200, ReleaseHistory.{.Versions = selected[:count]})
}

#scope_export
// Only a hint for apps to check for updates; the update itself is verified.
LatestSequence :: (dbPath: string, appID: string) -> s64 {
    if !identity.ValidNamespace(appID) {
        return 0
    }
    metadata := files.ReadFile(Join(Join(dbPath, ".packages/"), Join(appID, "/latest-v2.json")))
    value: release.ReleaseV2
    if metadata.error != null || metadata.value.count > 65536 ||
    json.Unmarshal(metadata.value, *value) != null || value.AppID != appID || value.Sequence < 0 {
        return 0
    }
    return value.Sequence
}

Route :: (context: registry.Registry, writer: http.ResponseWriter,
    request: *http.Request) {
    path := TrimPrefix(url.Path(http.RequestURL(request)), "/api/v2/packages/")
    parts := Split(path, "/")
    if (parts.count != 2 && parts.count != 3) || !identity.ValidNamespace(parts[0]) {
        response.Error(writer, 404, "package not found")
        return
    }
    appID := parts[0]
    asset := parts[1]
    if !LocalPath(appID) {
        response.Error(writer, 404, "package not found")
        return
    }
    if !LocalPath(asset) {
        response.Error(writer, 404, "package not found")
        return
    }
    grant := ""
    if parts.count == 3 {
        grant = parts[2]
        if asset == "latest" || asset == "history" || grant == "" {
            response.Error(writer, 404, "package not found")
            return
        }
    }
    app := store.ByID(context.database, http.Context(request), appID)
    if app.error != null {
        response.Error(writer, 500, "package registry unavailable")
        return
    }
    if !app.found || app.value.Status != "active" ||
    (app.value.ManifestExpiresAt > 0 &&
        app.value.ManifestExpiresAt <= clock.Unix(clock.Now())) {
        response.Error(writer, 404, "package not found")
        return
    }
    root := Join(Join(context.configuration.DBPath, ".packages/"), Join(appID, "/"))
    if asset == "history" {
        History(context, writer, request, root, appID)
        return
    }
    filename := "latest-v2.json"
    hash := ""
    if asset != "latest" {
        hash = ArtifactHash(asset)
        if hash == "" {
            response.Error(writer, 404, "package not found")
            return
        }
        filename = Join(asset, ".release-v2.json")
    }
    metadata := files.ReadFile(Join(root, filename))
    if metadata.error != null {
        response.Error(writer, 404, "portable release unavailable")
        return
    }
    value: release.ReleaseV2
    if metadata.value.count > 65536 ||
    json.Unmarshal(metadata.value, *value) != null ||
    !release.Valid(value, appID) {
        response.Error(writer, 503, "invalid portable release")
        return
    }
    if !Trusted(context, request, value) {
        response.Error(writer, 503, "untrusted portable release")
        return
    }
    if asset == "latest" {
        wanted := Wanted(request)
        bucket := Bucket(request)
        if !wanted.valid || bucket < 0 {
            response.Error(writer, 400, "invalid interface version, format or bucket")
            return
        }
        if !Fits(value, wanted) || !InFormat(root, value, wanted) ||
        HeldBack(root, value.Sequence, bucket) {
            older := Older(context, request, root, appID, value.Sequence, wanted)
            if !older.found {
                response.Error(writer, 404, "no release for this app version")
                return
            }
            value = older.value
        }
        http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", "no-store")
        response.JSON(writer, 200, value)
        return
    }
    expected: s64 = 0
    for artifact: value.Artifacts {
        if artifact.SHA256 == hash {
            expected = artifact.Size
        }
    }
    if expected == 0 {
        response.Error(writer, 404, "package not found")
        return
    }
    // A grant on an artifact that is not gated changes nothing.
    gate := grants.Gate(Join(root, asset))
    if gate.gated && !grants.Valid(context.configuration.WaoziIssuerPublicKey, grant,
        gate.product, clock.Unix(clock.Now())) {
        response.Error(writer, 403, "package grant required")
        return
    }
    bundle := files.ReadFile(Join(root, asset))
    if bundle.error != null || bundle.value.count != expected ||
    signing.SHA256Hex(bundle.value) != hash {
        response.Error(writer, 503, "portable release bytes do not match")
        return
    }
    caching := "public, max-age=31536000, immutable"
    if gate.gated {
        caching = "private, no-store"
    }
    http.SetHeader(http.ResponseHeaders(writer), "Content-Type", "application/octet-stream")
    http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", caching)
    http.SetHeader(http.ResponseHeaders(writer), "ETag", Join("\"", Join(hash, "\"")))
    unused Write(writer, bundle.value)
}
