// Protocol records preserve the released JSON names and omission rules.

ChallengeResponse :: struct {
    UserIDHash: string #go_tag "json:\"user_id_hash\""
    Nonce: string #go_tag "json:\"nonce\""
    ExpiresIn: s64 #go_tag "json:\"expires_in_seconds\""
}

LoginRequest :: struct {
