#import "std/go_types"
#import "std/map_go"
json :: #import "std/json_go";
text :: #import "std/text_go";
Paths :: () -> Map(string, Any) {
    result: Map(string, Any)
    json.Unmarshal(text.ToBytes(Document), *result)
    return result
}
#scope_file
Document :: #string JSON
{
 "/api/v1/referrals/me":{"get":{"summary":"Read your canonical Waozi referral program","description":"Existing signed-account Bearer required. Durable unlimited-invite code and share URL, permanent referrer binding, acceptance date, welcome receipt, accepted_count, earned_units, reversed_units and pending_offset_units. Integer millionths. Earnings include every direct friend's verified paid Dew purchase at floor(net paid units/20), without expiry. No individual friend purchase history. Private no-store.","responses":{"200":{"description":"status,authority,account_id,code,invite_url,referrer_id,accepted_at,welcome_receipt_id,accepted_count,earned_units,reversed_units,pending_offset_units"},"401":{"description":"Account authentication required"},"409":{"description":"wrong_node with canonical authority"},"503":{"description":"Issuer unavailable"}}}},
 "/api/v1/referrals/claim":{"post":{"summary":"Accept a referral and immediately receive20 Dew","description":"The signed account becomes permanently bound to at most one referrer at the canonical issuer. Atomically records acceptance and issues20000000 units, with no purchase, minimum spend, expiry or hold. Public alias/account ID and acceptance date become visible to inviter. Same account/code retries return original receipt. A different code cannot replace a referrer. source_app_id is attribution only, never proof of store origin.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["code","request_id"],"properties":{"code":{"type":"string","minLength":32,"maxLength":32},"request_id":{"type":"string","minLength":8,"maxLength":128},"source_app_id":{"type":"string","maxLength":64}}}}}},"responses":{"200":{"description":"bound or already_bound; referrer_id,accepted_at,welcome_units,welcome_receipt_id"},"400":{"description":"invalid_request"},"401":{"description":"Account authentication required"},"404":{"description":"invalid_code"},"409":{"description":"revoked_code,self_referral,already_bound,request_conflict or wrong_node"},"503":{"description":"unavailable; retry same request"}}}},
 "/api/v1/referrals/accepted":{"get":{"summary":"List everyone who accepted your code","description":"Bearer account's accepted friends including nonpurchasers. Immutable increasing acceptance sequence; default50,max100. Each row: account_id,display_name,alias,accepted_at,cursor. Public ID fallback after alias loss/account deletion. next_cursor decimal string or empty at end. No private payment history. Private no-store.","parameters":[{"name":"cursor","in":"query","schema":{"type":"integer","minimum":0}},{"name":"limit","in":"query","schema":{"type":"integer","minimum":1,"maximum":100,"default":50}}],"responses":{"200":{"description":"accepted array and next_cursor"},"400":{"description":"invalid_request"},"401":{"description":"Account authentication required"},"409":{"description":"wrong_node"}}}},
 "/api/v1/referrals/code/rotate":{"post":{"summary":"Rotate your invitation code","description":"Revokes previous code for new claims. Existing relationships/list/rewards persist. Account/request idempotent.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","additionalProperties":false,"required":["request_id"],"properties":{"request_id":{"type":"string","minLength":8,"maxLength":128}}}}}},"responses":{"200":{"description":"code,invite_url"},"400":{"description":"invalid_request"},"401":{"description":"Account authentication required"},"409":{"description":"wrong_node"},"503":{"description":"unavailable"}}}}
}
JSON;
