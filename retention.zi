// A periodic job that deletes what the node no longer needs: each account's
// daily chat counts after 30 days and once the account is gone, Lumi's
// handled Telegram updates, delivered or orphaned report copies and expired
// link codes, deleted accounts whose 30-day hold is over and blobs that
// spent 30 days in the trash.
#import "std/go_types"
lumi :: #import "lumi_telegram";
holds :: #import "account_hold";
storage :: #import "account_storage";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
clock :: #import "std/time_go";
selection :: #import "std/select_go";
errors :: #import "std/errors_go";
go_time :: #system_library "go:time";
go_slog :: #system_library "go:log/slog";
go_sql :: #system_library "go:database/sql";
go_context :: #system_library "go:context";

// Chat allowances count requests per UTC day; those counts are kept this long.
ChatUsageDays :: 30
// How often the job runs, in nanoseconds: one hour.
Interval :: 3600000000000

#scope_file
Day :: 86400000000000
TableResult :: struct {
    exists: bool
    error: Error
}
StopAtReturn :: (ticker: *clock.Ticker) #go_defer #foreign go_time "(*Ticker).Stop";
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign go_sql "(*Tx).Rollback";
LogWarning :: (message: string, key: string, error: Error) #foreign go_slog "Warn";
ContextError :: (value: ctx.Context) -> Error #foreign go_context "Context.Err";
Stopped :: (value: ctx.Context) -> bool {
    return ContextError(value) != null
}

// Lumi creates its tables on first use, so a node that never used Lumi's
// Telegram input has none.
LumiTables :: (database: *sql.Database, context: ctx.Context) -> TableResult {
    result: TableResult
    exists: s64
    destinations: [1]Any = .[*exists]
    empty: [0]Any
    row := sql.QueryRow(database, context,
        "SELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='server_lumi_updates')", empty[:])
    result.error = sql.ScanRow(row, destinations[:])
    result.exists = exists != 0
    return result
}

#scope_export
Prune :: (database: *sql.Database, context: ctx.Context, now: clock.Time) -> Error {
    tables := LumiTables(database, context)
    if tables.error != null {
        return tables.error
    }
    // The store has one connection, so the schema is ensured before the
    // transaction takes it.
    if tables.exists && !lumi.EnsureSchema(database, context) {
        return errors.New("Lumi schema unavailable")
    }
    opened := sql.Begin(database, context, null)
    if opened.error != null {
        return opened.error
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    oldest := clock.Add(now, cast(clock.Duration)(0 - ChatUsageDays * Day))
    kept: [1]Any = .[clock.Format(clock.UTC(oldest), "2006-01-02")]
    usage := sql.ExecTx(transaction, context, "DELETE FROM server_chat_usage WHERE day<?1", kept[:])
    if usage.error != null {
        return usage.error
    }
    // Account deletion removes its counts; a request answered while the
    // account was being deleted can still leave one behind. The node's own
    // total and the explicitly configured group allowance are not accounts.
    empty: [0]Any
    orphaned := sql.ExecTx(transaction, context,
        "DELETE FROM server_chat_usage WHERE account_id NOT IN ('node','lumi-group') AND NOT EXISTS(SELECT 1 FROM server_users WHERE user_id_hash=server_chat_usage.account_id)", empty[:])
    if orphaned.error != null {
        return orphaned.error
    }
    if tables.exists {
        error := lumi.Prune(transaction, context, clock.Unix(now))
        if error != null {
            return error
        }
    }
    return sql.Commit(transaction)
}

// Deletes the files of held accounts and trashed blobs whose time is up.
PruneFiles :: (database: *sql.Database, context: ctx.Context, dbPath: string, now: clock.Time) -> Error {
    error := holds.Purge(database, context, dbPath, now)
    if error != null {
        return error
    }
    return storage.PurgeTrashedBlobs(database, context, dbPath, clock.Unix(now))
}

// Prunes once at start and then at every interval until the context ends.
Run :: (database: *sql.Database, context: ctx.Context, interval: clock.Duration, dbPath: string) {
    if cast(s64)interval <= 0 {
        interval = cast(clock.Duration)Interval
    }
    ticker := clock.NewTicker(interval)
    StopAtReturn(ticker)
    cases: [2]selection.Case
    cases[0] = selection.Receive(ctx.Done(context))
    cases[1] = selection.Receive(clock.TickerChannel(ticker))
    while true {
        now := clock.Now()
        error := Prune(database, context, now)
        // Stopping ends the context and rolls back a prune in progress, which
        // then fails with an error of its own; that is not a failure.
        if error != null && !Stopped(context) {
            LogWarning("data retention failed", "error", error)
        }
        error = PruneFiles(database, context, dbPath, now)
        if error != null && !Stopped(context) {
            LogWarning("held data retention failed", "error", error)
        }
        if selection.Select(cases[:]).chosen == cast(isize)0 {
            return
        }
    }
}
