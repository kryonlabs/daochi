// The days an account checked in with a game, for rewards that pay after
// that many days in a row, such as Wurm's daily plan. The node counts UTC days
// by its own clock, so a client can neither choose a day nor count one twice,
// and a missed day starts the count over.
#import "std/go_types"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
errors :: #import "std/errors_go";

DaySeconds :: 86400

CheckInResult :: struct {
    // The account's consecutive check-in days for the game, ending today.
    days: s64
    error: Error
}

#scope_file
Schema :: #string SQL
CREATE TABLE IF NOT EXISTS reward_checkins (
 account_id TEXT NOT NULL REFERENCES server_users(user_id_hash) ON DELETE CASCADE,
 game TEXT NOT NULL, day INTEGER NOT NULL, created_at INTEGER NOT NULL,
 PRIMARY KEY(account_id,game,day)
);
SQL
InsertCheckIn :: "INSERT INTO reward_checkins(account_id,game,day,created_at) VALUES(?1,?2,?3,?4) ON CONFLICT DO NOTHING";
// Walking back from today, each earlier row sits one position further down, so
// day + position stays today + 1 until the first missed day.
CountStreak :: #string SQL
SELECT COUNT(*) FROM (
 SELECT day, ROW_NUMBER() OVER (ORDER BY day DESC) AS position
 FROM reward_checkins WHERE account_id=?1 AND game=?2 AND day<=?3
) WHERE day + position = ?3 + 1
SQL

#scope_export
SchemaSQL :: () -> string {
    return Schema
}

// The UTC day of a Unix time, in days since 1970.
Day :: (unix_seconds: s64) -> s64 {
    if unix_seconds < 0 {
        return -1
    }
    return unix_seconds / DaySeconds
}

// Checks the account in for the UTC day of now, once per day, and counts its
// consecutive check-in days for the game, ending today.
CheckIn :: (database: *sql.Database, context: ctx.Context, account: string, game: string,
    now: s64) -> CheckInResult {
    result: CheckInResult
    day := Day(now)
    if day < 0 {
        result.error = errors.New("invalid check-in time")
        return result
    }
    values: [4]Any = .[account, game, day, now]
    written := sql.Exec(database, context, InsertCheckIn, values[:])
    if written.error != null {
        result.error = written.error
        return result
    }
    arguments: [3]Any = .[account, game, day]
    destinations: [1]Any = .[*result.days]
    result.error = sql.ScanRow(sql.QueryRow(database, context, CountStreak, arguments[:]), destinations[:])
    return result
}
