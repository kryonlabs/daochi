// Game rewards an account claims for itself, such as Shovey's secret chest.
// The node keeps the catalog, which rewards exist and the Dew each gives; the
// client names only the reward. token_reward gives a reward to an account
// once, so claiming it again credits nothing and reports the balance.
// Finishing Shovey's campaign pays by place: more Dew for the first finishers.
// Wurm's daily plan pays its Dew days once the node has counted enough days.
#import "std/go_types"
service :: #import "account_http";
rewards :: #import "token_reward";
evidence :: #import "game_evidence";
checkins :: #import "reward_checkin";
auth :: #import "http_auth";
body :: #import "http_body";
response :: #import "response";
identity :: #import "identity";
strict :: #import "strict_json";
http :: #import "std/http_go";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
ed :: #import "std/ed25519_go";
clock :: #import "std/time_go";
builtin :: #system_library "go:builtin";

RewardCommand :: struct {
    reward: string #go_tag "json:\"reward\""
}

RewardOffer :: struct {
    reward: string #go_tag "json:\"reward\""
    units: s64 #go_tag "json:\"units\""
}

RewardOffers :: struct {
    rewards: []RewardOffer #go_tag "json:\"rewards\""
}

RewardClaim :: struct {
    reward: string #go_tag "json:\"reward\""
    units: s64 #go_tag "json:\"units\""
    credited: bool #go_tag "json:\"credited\""
    balance: s64 #go_tag "json:\"balance\""
    // The account's finishing place, for a reward that pays by place.
    place: s64 #go_tag "json:\"place,omitempty\""
}

// The rewards and their Dew, in integer millionths; the campaign's is its
// Dew after the 100th finisher (see CampaignPlaces).
RewardCount :: 7
RewardNames: [7]string = .["shovey.secret-chest", "shovey.campaign-complete", "wurm.daily-05", "wurm.daily-10",
    "wurm.daily-15", "wurm.daily-20", "wurm.daily-25"];
RewardUnits: [7]s64 = .[2000000, 5000000, 1000000, 2000000, 2000000, 2000000, 3000000];

// Wurm's daily plan: each Dew day is claimable once the node has counted that
// many UTC check-in days for the account. Every claim of one checks the
// account in for today, so a player who claims each day reaches each Dew day
// on time, and no client can add a day the node did not see.
DailyGame :: "wurm";
DailyCount :: 5
DailyNames: [5]string = .["wurm.daily-05", "wurm.daily-10", "wurm.daily-15", "wurm.daily-20", "wurm.daily-25"];
DailyDays: [5]s64 = .[5, 10, 15, 20, 25];

// Finishing the campaign: the first 10 finishers get 100 Dew, the next 20 get
// 50, those up to the 100th get 20, and everyone after 5.
CampaignReward :: "shovey.campaign-complete";
CampaignPlaces: [3]s64 = .[10, 30, 100];
CampaignUnits: [4]s64 = .[100000000, 50000000, 20000000, 5000000];
// Before places came on 2026-10-27, every finisher got a flat 5 Dew (0.5
// before the 10-25 rescale, which multiplied it by ten). Credits from before
// CampaignPlacesFrom (UTC) may be flat ones; later credits are all by place.
CampaignFlatUnits :: 5000000
CampaignPlacesFrom :: "2026-10-28 00:00:00";

MakeOffers :: (count: isize) -> []RewardOffer #foreign builtin "make";

// The check-in days a daily reward needs, or 0 for a reward that is not one.
RequiredDays :: (reward: string) -> s64 {
    for index: cast(s32)0..DailyCount - 1 {
        if DailyNames[index] == reward {
            return DailyDays[index]
        }
    }
    return 0
}
AppendOffer :: (values: []RewardOffer, value: RewardOffer) -> []RewardOffer #foreign builtin "append";

// The Dew a reward gives, or 0 for a reward the node does not offer.
Units :: (reward: string) -> s64 {
    for index: cast(s32)0..RewardCount - 1 {
        if RewardNames[index] == reward { return RewardUnits[index] }
    }
    return 0
}

// The Dew the next claim of a reward gives.
OfferUnits :: (database: *sql.Database, context: ctx.Context, reward: string) -> s64 {
    if reward != CampaignReward {
        return Units(reward)
    }
    next := rewards.NextPlaceUnits(database, context, reward, CampaignPlaces[:], CampaignUnits[:])
    if next.error != null {
        return 0
    }
    return next.value
}

// Finishers credited the flat 5 Dew get the rest of their place's Dew. Run at
// start; each finisher is topped up once.
SettleCampaign :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey) -> rewards.SettleResult {
    return rewards.SettlePlaces(database, context, signer, CampaignReward, CampaignPlaces[:], CampaignUnits[:],
        CampaignFlatUnits, CampaignPlacesFrom)
}

#scope_file
ReadCommand :: (writer: http.ResponseWriter, request: *http.Request) -> RewardCommand {
    command: RewardCommand
    read := body.ReadJSON(writer, request, 1024)
    if read.error != null || strict.Decode(read.value, *command) != null ||
    !identity.ValidNamespace(command.reward) {
        command.reward = ""
    }
    return command
}

#scope_export
// GET lists the rewards and their Dew; POST claims one for the account.
Handle :: (accounts: service.Accounts, writer: http.ResponseWriter, request: *http.Request) {
    user := auth.BearerUser(accounts.database, request, accounts.configuration.TokenSecret)
    if user.authentication.error != null || user.authentication.status != 0 {
        auth.Respond(writer, accounts.counters, user.authentication)
        return
    }
    http.SetHeader(http.ResponseHeaders(writer), "Cache-Control", "private, no-store")
    if http.Method(request) != "POST" {
        offers: RewardOffers
        offers.rewards = MakeOffers(cast(isize)0)
        for index: cast(s32)0..RewardCount - 1 {
            units := OfferUnits(accounts.database, http.Context(request), RewardNames[index])
            if units <= 0 {
                response.Error(writer, 503, "rewards unavailable")
                return
            }
            offers.rewards = AppendOffer(offers.rewards, RewardOffer.{.reward = RewardNames[index], .units = units})
        }
        response.JSON(writer, 200, offers)
        return
    }
    command := ReadCommand(writer, request)
    if command.reward == "" {
        response.Error(writer, 400, "invalid reward")
        return
    }
    units := Units(command.reward)
    if units <= 0 {
        response.Error(writer, 404, "unknown reward")
        return
    }
    required := RequiredDays(command.reward)
    if required > 0 {
        counted := checkins.CheckIn(accounts.database, http.Context(request), user.value, DailyGame,
            clock.Unix(clock.Now()))
        if counted.error != null {
            response.Error(writer, 503, "check-ins unavailable")
            return
        }
        if counted.days < required {
            response.Error(writer, 403, "check in on more days before claiming this reward")
            return
        }
    } else {
        eligibility := evidence.Eligible(accounts.database, http.Context(request), user.value, command.reward)
        if eligibility.error != null {
            response.Error(writer, 503, "completion archive unavailable")
            return
        }
        if !eligibility.eligible {
            response.Error(writer, 403, "sync complete evidence for every required level with at least 10 moves before claiming this reward")
            return
        }
    }
    given: rewards.RewardResult
    if command.reward == CampaignReward {
        given = rewards.GiveByPlace(accounts.database, http.Context(request), accounts.configuration.WaoziIssuerPrivateKey,
            command.reward, user.value, CampaignPlaces[:], CampaignUnits[:])
    } else {
        given = rewards.Give(accounts.database, http.Context(request), accounts.configuration.WaoziIssuerPrivateKey,
            command.reward, user.value, units)
    }
    if given.error != null {
        response.Error(writer, 503, "rewards unavailable")
        return
    }
    claim := RewardClaim.{.reward = command.reward, .units = given.units, .credited = given.credited,
        .balance = given.balance, .place = given.place}
    response.JSON(writer, 200, claim)
}
