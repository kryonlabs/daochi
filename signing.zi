go_sha256 :: #system_library "crypto/sha256";
go_hex :: #system_library "encoding/hex";
go_strings :: #system_library "go:strings";

Sum256 :: (value: []u8) -> [32]u8 #foreign go_sha256 "Sum256";
EncodeHex :: (value: []u8) -> string #foreign go_hex "EncodeToString";
Upper :: (value: string) -> string #foreign go_strings "ToUpper";
Join :: (values: []string, separator: string) -> string #foreign go_strings "Join";

CanonicalMessage :: (nonce: []u8, method: string, path: string, payload: []u8) -> string {
    return CanonicalMessageWithContext("ksync-sync-v1", nonce, method, path, payload)
}

CanonicalMessageWithContext :: (context: string, nonce: []u8, method: string, path: string, payload: []u8) -> string {
    sum: [32]u8 = Sum256(payload)
    parts: [6]string = .[context, Upper(method), path, EncodeHex(sum[:]), EncodeHex(nonce), ""]
    return Join(parts[:], "\n")
}

SHA256Hex :: (value: []u8) -> string {
    sum: [32]u8 = Sum256(value)
    return EncodeHex(sum[:])
}

NodeRequestMessage :: (context: string, nodeID: string, timestamp: string, nonce: string, method: string, path: string, body: []u8) -> string {
    parts: [8]string = .[context, nodeID, timestamp, nonce, Upper(method), path, SHA256Hex(body), ""]
    return Join(parts[:], "\n")
}

AppApprovalMessage :: (context: string, appID: string, manifestHash: string) -> string {
    parts: [4]string = .[context, appID, manifestHash, ""]
    return Join(parts[:], "\n")
}
