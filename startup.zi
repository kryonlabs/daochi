config :: #import "config";
plans :: #import "storage_plan";
rescales :: #import "token_rescale";
rewards :: #import "token_reward";
game_rewards :: #import "reward_http";
checkpoints :: #import "token_checkpoint";
policy :: #import "token_policy";
tokens :: #import "token";
storage :: #import "store";
verification :: #import "verifier";
node :: #import "node_identity";
application :: #import "server";
access :: #import "account_access";
inspection :: #import "inspect";
invoices :: #import "monero_invoices";
mesh :: #import "mesh";
discovery :: #import "discovery";
retention :: #import "retention";
exchange_rates :: #import "exchange_rate";
middleware :: #import "middleware";
ctx :: #import "std/context_go";
clock :: #import "std/time_go";
net :: #import "std/net_go";
selection :: #import "std/select_go";
io :: #import "std/io_go";
errors :: #import "std/errors_go";
go_os :: #system_library "go:os";
go_signal :: #system_library "go:os/signal";
go_syscall :: #system_library "go:syscall";
go_sync :: #system_library "go:sync";
go_http :: #system_library "go:net/http";
go_log :: #system_library "go:log";
go_slog :: #system_library "go:log/slog";
go_strings :: #system_library "go:strings";
go_net :: #system_library "go:net";
go_format :: #system_library "go:fmt";
builtin :: #system_library "go:builtin";

HTTPServer :: #type #foreign go_http "Server";
WorkerGroup :: #type #foreign go_sync "WaitGroup";
Worker :: #type (server: *application.Server, context: ctx.Context) -> void;
Workers :: struct {
    invoices: Worker
    mesh: Worker
    discovery: Worker
    retention: Worker
    rates: Worker
}
VerifierFactory :: #type () -> verification.VerifierResult;
Listen :: #type (server: *HTTPServer) -> Error;
Shutdown :: #type (server: *HTTPServer, context: ctx.Context) -> Error;

#scope_file
Signal :: #type #foreign go_os "Signal";
Logger :: #type #foreign go_log "Logger";
CancelCallback :: #type (callback: ctx.CancelFunc) -> void;
CloseCallback :: #type (store: *storage.Store) -> void;
WorkerTask :: struct {
    group: *WorkerGroup
    callback: Worker
    server: *application.Server
    context: ctx.Context
}
ShutdownTask :: struct {
    server: *HTTPServer
    context: ctx.Context
    shutdown: Shutdown
}
WorkerCallback :: #type (task: WorkerTask) -> void;
ShutdownCallback :: #type (task: ShutdownTask) -> void;
Arguments :: () -> []string #go_field #foreign go_os "Args";
Interrupt :: () -> Signal #go_field #foreign go_os "Interrupt";
Terminate :: () -> Signal #go_field #foreign go_syscall "SIGTERM";
NotifyContext :: (parent: ctx.Context, interrupt: Signal, terminate: Signal) -> ctx.Cancellation #go_results #foreign go_signal;
CancelAtReturn :: (callback: CancelCallback, cancel: ctx.CancelFunc) #go_defer #foreign builtin "call";
CloseAtReturn :: (callback: CloseCallback, store: *storage.Store) #go_defer #foreign builtin "call";
CompleteAtReturn :: (group: *WorkerGroup) #go_defer #foreign go_sync "(*WaitGroup).Done";
AddWorker :: (group: *WorkerGroup, count: isize) #foreign go_sync "(*WaitGroup).Add";
WaitWorkers :: (group: *WorkerGroup) #foreign go_sync "(*WaitGroup).Wait";
SpawnWorker :: (callback: WorkerCallback, task: WorkerTask) #foreign builtin "spawn";
SpawnShutdown :: (callback: ShutdownCallback, task: ShutdownTask) #foreign builtin "spawn";
TrimSpace :: (value: string) -> string #foreign go_strings;
Join :: (parts: []string, separator: string) -> string #foreign go_strings;
JoinHostPort :: (host: string, port: string) -> string #foreign go_net;
FatalError :: (format: string, error: Error) #foreign go_log "Fatalf";
FatalMessage :: (message: string) #foreign go_log "Fatal";
LogError :: (message: string, key: string, error: Error) #foreign go_slog "Error";
LogSettled :: (message: string, accountsKey: string, accounts: s64, unitsKey: string, units: s64) #foreign go_slog "Info";
LogListening :: (message: string, urlKey: string, url: string, addressKey: string, address: string,
    baseURLKey: string, baseURL: string, databaseKey: string, database: string) #foreign go_slog "Info";
AllocateHTTP :: () -> *HTTPServer #foreign builtin "new";
SetAddress :: (server: *HTTPServer, address: string) #go_field #foreign go_http "(*Server).Addr";
SetHandler :: (server: *HTTPServer, handler: middleware.Handler) #go_field #foreign go_http "(*Server).Handler";
SetReadHeaderTimeout :: (server: *HTTPServer, duration: clock.Duration) #go_field #foreign go_http "(*Server).ReadHeaderTimeout";
SetReadTimeout :: (server: *HTTPServer, duration: clock.Duration) #go_field #foreign go_http "(*Server).ReadTimeout";
SetWriteTimeout :: (server: *HTTPServer, duration: clock.Duration) #go_field #foreign go_http "(*Server).WriteTimeout";
SetIdleTimeout :: (server: *HTTPServer, duration: clock.Duration) #go_field #foreign go_http "(*Server).IdleTimeout";
SetMaxHeaderBytes :: (server: *HTTPServer, size: isize) #go_field #foreign go_http "(*Server).MaxHeaderBytes";
SetErrorLog :: (server: *HTTPServer, logger: *Logger) #go_field #foreign go_http "(*Server).ErrorLog";
StandardError :: () -> io.Writer #go_field #foreign go_os "Stderr";
StandardLogFlags :: () -> isize #go_field #foreign go_log "LstdFlags";
NewLogger :: (writer: io.Writer, prefix: string, flags: isize) -> *Logger #foreign go_log "New";
ListenHTTP :: (server: *HTTPServer) -> Error #foreign go_http "(*Server).ListenAndServe";
ShutdownHTTP :: (server: *HTTPServer, context: ctx.Context) -> Error #foreign go_http "(*Server).Shutdown";
ServerClosed :: () -> Error #go_field #foreign go_http "ErrServerClosed";
PrintRescale :: (format: string, status: string, factor: s64, accounts: s64, before: s64, after: s64,
    intents: s64, deposits: s64) #foreign go_format "Printf";
PrintCheckpoint :: (format: string, sequence: s64, root: string) #foreign go_format "Printf";
PrintReward :: (format: string, reward: string, status: string, dew: s64, account: string, balance: s64) #foreign go_format "Printf";
PrintNote :: (format: string) #foreign go_format "Printf";
PrintSetting :: (format: string, value: s64) #foreign go_format "Printf";
PrintText :: (format: string, value: string) #foreign go_format "Printf";
Getenv :: (key: string) -> string #foreign go_os "Getenv";
Minute :: 60000000000;
Second :: 1000000000;

CloseStore :: (store: *storage.Store) {
    storage.Close(store)
}

RunWorker :: (task: WorkerTask) {
    CompleteAtReturn(task.group)
    task.callback(task.server, task.context)
}

StartWorker :: (group: *WorkerGroup, callback: Worker, server: *application.Server, context: ctx.Context) {
    task: WorkerTask
    task.group = group
    task.callback = callback
    task.server = server
    task.context = context
    AddWorker(group, cast(isize)1)
    SpawnWorker(RunWorker, task)
}

RunShutdown :: (task: ShutdownTask) {
    ShutdownOnCancel(task.server, task.context, task.shutdown)
}

ListenNative :: (server: *HTTPServer) -> Error {
    return ListenHTTP(server)
}

ShutdownNative :: (server: *HTTPServer, context: ctx.Context) -> Error {
    return ShutdownHTTP(server, context)
}

RunInvoices :: (server: *application.Server, context: ctx.Context) {
    invoices.Run(application.Monero(server), context, cast(clock.Duration)Minute)
}

RunMesh :: (server: *application.Server, context: ctx.Context) {
    mesh.Run(application.Mesh(server), context)
}

RunDiscovery :: (server: *application.Server, context: ctx.Context) {
    discovery.Run(*server.cfg, *server.node, context, discovery.Register, discovery.Shutdown)
}

RunRetention :: (server: *application.Server, context: ctx.Context) {
    retention.Run(server.store.database, context, cast(clock.Duration)retention.Interval, server.cfg.DBPath)
}

RunRates :: (server: *application.Server, context: ctx.Context) {
    exchange_rates.Run(server.store.database, context, exchange_rates.Sources(),
        cast(clock.Duration)exchange_rates.RefreshInterval)
}

#scope_export
LocalHTTPURL :: (address: string) -> string {
    split := net.SplitHostPort(address)
    host := split.host
    if split.error != null {
        parts: [2]string = .["http://", address]
        return Join(parts[:], "")
    }
    if host == "" || host == "0.0.0.0" || host == "::" {
        host = "127.0.0.1"
    }
    parts: [2]string = .["http://", JoinHostPort(host, split.port)]
    return Join(parts[:], "")
}

NativeWorkers :: () -> Workers {
    result: Workers
    result.invoices = RunInvoices
    result.mesh = RunMesh
    result.discovery = RunDiscovery
    result.retention = RunRetention
    result.rates = RunRates
    return result
}

StartWorkers :: (server: *application.Server, context: ctx.Context, group: *WorkerGroup, workers: Workers) {
    // A configured wallet must settle deposits and late invoices even when purchases are disabled.
    if server.cfg.TokenDirectPurchasesEnabled || TrimSpace(server.cfg.MoneroWalletRPCURL) != "" {
        StartWorker(group, workers.invoices, server, context)
    }
    StartWorker(group, workers.mesh, server, context)
    StartWorker(group, workers.discovery, server, context)
    StartWorker(group, workers.retention, server, context)
    StartWorker(group, workers.rates, server, context)
}

NewHTTPServer :: (address: string, handler: middleware.Handler) -> *HTTPServer {
    server := AllocateHTTP()
    SetAddress(server, address)
    SetHandler(server, handler)
    SetReadHeaderTimeout(server, cast(clock.Duration)(5 * Second))
    SetReadTimeout(server, cast(clock.Duration)(15 * Second))
    SetWriteTimeout(server, cast(clock.Duration)(15 * Second))
    SetIdleTimeout(server, cast(clock.Duration)(60 * Second))
    // Daochi's headers are small; Go's 1 MiB default lets each request park
    // large values in rate-limit and challenge keys.
    SetMaxHeaderBytes(server, cast(isize)65536)
    SetErrorLog(server, NewLogger(StandardError(), "http: ", StandardLogFlags()))
    return server
}

ShutdownOnCancel :: (server: *HTTPServer, context: ctx.Context, shutdown: Shutdown) {
    cases: [1]selection.Case
    cases[0] = selection.Receive(ctx.Done(context))
    selection.Select(cases[:])
    deadline := ctx.WithTimeout(ctx.Background(), cast(clock.Duration)(15 * Second))
    CancelAtReturn(ctx.Cancel, deadline.cancel)
    error := shutdown(server, deadline.value)
    if error != null {
        LogError("HTTP shutdown failed", "error", error)
    }
}

Serve :: (server: *HTTPServer, configuration: config.Config, context: ctx.Context,
    stop: ctx.CancelFunc, group: *WorkerGroup, listen: Listen, shutdown: Shutdown) {
    task: ShutdownTask
    task.server = server
    task.context = context
    task.shutdown = shutdown
    SpawnShutdown(RunShutdown, task)
    LogListening("Daochi sync server listening", "url", LocalHTTPURL(configuration.Addr), "addr", configuration.Addr,
        "base_url", configuration.BaseURL, "db", configuration.DBPath)
    error := listen(server)
    if error != null && error != ServerClosed() {
        LogError("serve failed", "error", error)
    }
    ctx.Cancel(stop)
    WaitWorkers(group)
}

WithNodeKey :: (configuration: config.Config) -> config.Config {
    privateKey := cast([]u8)configuration.NodeIdentityPrivateKey
    if privateKey.count == 0 {
        key := node.LoadOrCreateKey(configuration.NodeIdentityKeyFile)
        if key.error != null {
            FatalError("load node identity: %v", key.error)
        }
        configuration.NodeIdentityPrivateKey = key.value
    }
    return configuration
}

#scope_file
ApplyRescale :: (configuration: config.Config, name: string, factor: s64) -> Error {
    issuer := policy.Issuer(configuration, errors.New("rescaling needs the Dew issuer private key"))
    if issuer.error != null {
        return issuer.error
    }
    opened := storage.Open(configuration.DBPath)
    if opened.error != null {
        return opened.error
    }
    store := opened.value
    CloseAtReturn(CloseStore, store)
    context := ctx.Background()
    result := rescales.Apply(store.database, context, issuer.value, name, factor)
    if result.error != null {
        return result.error
    }
    status := "applied"
    if !result.applied {
        status = "already applied"
    }
    PrintRescale("Dew rescale %s: factor %d, %d accounts credited, %d units before, %d units after, %d invoices and %d deposits scaled\n",
        status, result.factor, result.accounts, result.units_before, result.units_after,
        result.intents, result.deposits)
    checkpoint := checkpoints.Create(store.database, context, issuer.value,
        errors.New("Dew issuer unavailable"))
    if checkpoint.error != null {
        return checkpoint.error
    }
    PrintCheckpoint("Dew checkpoint at ledger sequence %d, root %s\n",
        checkpoint.value.LedgerSeq, checkpoint.value.LedgerRoot)
    return null
}

// Run once with the service stopped, after the node's Dew per XMR ratio changes.
// NAME is new for each ratio change, so the same rescale never applies twice.
RescaleDew :: (configuration: config.Config, arguments: []string) -> Error {
    usage := errors.New("usage: daochi rescale-dew NAME FACTOR")
    if arguments.count != 2 {
        return usage
    }
    factor := tokens.ParseInteger(arguments[1])
    if !factor.is_ok {
        return usage
    }
    return ApplyRescale(configuration, arguments[0], factor.value)
}

// Run by the deploy with the service stopped, to move the node to ATOMIC Monero
// atomic units per UNITS Dew units. A whole-factor raise rescales Dew once under
// NAME and prints the node's new MONERO_RATE_* and DAOCHI_TOKEN_PRODUCTS lines.
// PRODUCTS ("id:Dew" items joined by commas) adds each product the node does
// not sell yet at that ratio and prints the new DAOCHI_TOKEN_PRODUCTS line.
// The node's current ratio and products print nothing to change.
DewRatio :: (configuration: config.Config, arguments: []string) -> Error {
    usage := errors.New("usage: daochi dew-ratio NAME ATOMIC UNITS [PRODUCTS]")
    if arguments.count != 3 && arguments.count != 4 {
        return usage
    }
    atomic := tokens.ParseInteger(arguments[1])
    units := tokens.ParseInteger(arguments[2])
    if !atomic.is_ok || !units.is_ok || atomic.value <= 0 || units.value <= 0 {
        return usage
    }
    wanted := ""
    if arguments.count == 4 {
        wanted = arguments[3]
    }
    currentAtomic := configuration.MoneroRateAtomicAmount
    currentUnits := configuration.MoneroRateTokenUnits
    raised := currentAtomic != atomic.value || currentUnits != units.value
    factor: s64 = 1
    if raised {
        if currentAtomic != atomic.value || currentUnits <= 0 || units.value % currentUnits != 0 ||
        units.value / currentUnits < 2 {
            return errors.New("the Dew ratio only rises by a whole factor at the same MONERO_RATE_ATOMIC_AMOUNT")
        }
        factor = units.value / currentUnits
    }
    rawProducts := Getenv("DAOCHI_TOKEN_PRODUCTS")
    products: rescales.ProductsResult
    products.value = rawProducts
    if raised {
        products = rescales.ScaleProducts(rawProducts, factor)
        if products.error != null {
            return products.error
        }
    }
    products = rescales.AddProducts(products.value, wanted, atomic.value, units.value)
    if products.error != null {
        return products.error
    }
    if raised {
        error := ApplyRescale(configuration, arguments[0], factor)
        if error != null {
            return error
        }
        PrintSetting("MONERO_RATE_ATOMIC_AMOUNT=%d\n", atomic.value)
        PrintSetting("MONERO_RATE_TOKEN_UNITS=%d\n", units.value)
    } else {
        PrintNote("Dew ratio unchanged\n")
    }
    if products.value != rawProducts || (raised && rawProducts != "") {
        PrintText("DAOCHI_TOKEN_PRODUCTS=%s\n", products.value)
    }
    return null
}

// Run with the service stopped. The same REWARD never credits an account twice.
RewardDew :: (configuration: config.Config, arguments: []string) -> Error {
    usage := errors.New("usage: daochi reward-dew REWARD ACCOUNT DEW")
    if arguments.count != 3 {
        return usage
    }
    dew := tokens.ParseInteger(arguments[2])
    if !dew.is_ok || dew.value <= 0 || dew.value > 1000000 {
        return usage
    }
    issuer := policy.Issuer(configuration, errors.New("rewards need the Dew issuer private key"))
    if issuer.error != null {
        return issuer.error
    }
    opened := storage.Open(configuration.DBPath)
    if opened.error != null {
        return opened.error
    }
    store := opened.value
    CloseAtReturn(CloseStore, store)
    context := ctx.Background()
    result := rewards.Give(store.database, context, issuer.value, arguments[0], arguments[1],
        dew.value * plans.UnitsPerDew)
    if result.error != null {
        return result.error
    }
    status := "credited"
    if !result.credited {
        status = "already credited"
    }
    PrintReward("Dew reward %s %s: %d Dew to account %s, balance now %d units\n",
        arguments[0], status, dew.value, result.account, result.balance)
    checkpoint := checkpoints.Create(store.database, context, issuer.value,
        errors.New("Dew issuer unavailable"))
    if checkpoint.error != null {
        return checkpoint.error
    }
    PrintCheckpoint("Dew checkpoint at ledger sequence %d, root %s\n",
        checkpoint.value.LedgerSeq, checkpoint.value.LedgerRoot)
    return null
}

// Finishers paid before the campaign paid by place get the rest of their
// place's Dew. A node without the Dew issuer gives no rewards to settle.
SettleCampaign :: (configuration: config.Config, store: *storage.Store) {
    issuer := policy.Issuer(configuration, errors.New("rewards need the Dew issuer private key"))
    if issuer.error != null {
        return
    }
    settled := game_rewards.SettleCampaign(store.database, ctx.Background(), issuer.value)
    if settled.error != null {
        LogError("settle campaign reward places", "error", settled.error)
        return
    }
    if settled.accounts > 0 {
        LogSettled("campaign reward places settled", "accounts", settled.accounts, "units", settled.units)
    }
}

RunPrepared :: (configuration: config.Config, arguments: []string, createVerifier: VerifierFactory,
    signer: access.SignPrivateKey) {
    if arguments.count > 1 && arguments[1] == "inspect" {
        options: inspection.InspectOptions
        options.DBPath = configuration.DBPath
        error := inspection.Run(ctx.Background(), arguments[2:], options)
        if error != null {
            FatalError("inspect: %v", error)
        }
        return
    }
    if arguments.count > 1 && arguments[1] == "reward-dew" {
        error := RewardDew(configuration, arguments[2:])
        if error != null {
            FatalError("reward-dew: %v", error)
        }
        return
    }
    if arguments.count > 1 && arguments[1] == "rescale-dew" {
        error := RescaleDew(configuration, arguments[2:])
        if error != null {
            FatalError("rescale-dew: %v", error)
        }
        return
    }
    if arguments.count > 1 && arguments[1] == "dew-ratio" {
        error := DewRatio(configuration, arguments[2:])
        if error != null {
            FatalError("dew-ratio: %v", error)
        }
        return
    }
    billingError := plans.ConfigurationError(configuration)
    if billingError != null {
        FatalError("storage billing configuration: %v", billingError)
    }
    opened := storage.Open(configuration.DBPath)
    if opened.error != null {
        FatalError("open store: %v", opened.error)
    }
    store := opened.value
    CloseAtReturn(CloseStore, store)
    SettleCampaign(configuration, store)
    verifier := createVerifier()
    if verifier.error != null {
        if errors.Is(verifier.error, verification.ErrVerifierUnavailable) {
            FatalMessage("ML-DSA-44 verifier unavailable: build with CGO_ENABLED=1 and liboqs installed")
        }
        FatalError("create verifier: %v", verifier.error)
    }
    server := application.New(configuration, store, verifier.value, signer)
    runtime := NotifyContext(ctx.Background(), Interrupt(), Terminate())
    CancelAtReturn(ctx.Cancel, runtime.cancel)
    group: WorkerGroup
    StartWorkers(server, runtime.value, *group, NativeWorkers())
    http := NewHTTPServer(configuration.Addr, application.Routes(server))
    Serve(http, configuration, runtime.value, runtime.cancel, *group, ListenNative, ShutdownNative)
}

#scope_export
Run :: (configuration: config.Config, arguments: []string, createVerifier: VerifierFactory,
    signer: access.SignPrivateKey) {
    RunPrepared(WithNodeKey(configuration), arguments, createVerifier, signer)
}

Main :: (createVerifier: VerifierFactory, signer: access.SignPrivateKey) {
    configuration := WithNodeKey(config.Load())
    RunPrepared(configuration, Arguments(), createVerifier, signer)
}
