// Prepaid storage time. A signed Dew debit and its expiry commit atomically.
#import "std/go_types"
#import "protocol"
ledger :: #import "token_ledger";
receipts :: #import "token_receipt";
wallet :: #import "monero_wallet";
configuration :: #import "config";
policy :: #import "token_policy";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
ed :: #import "std/ed25519_go";
clock :: #import "std/time_go";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
go_time :: #system_library "go:time";

FreeBytes :: 10485760
PaidBytes :: 1073741824
LargeBytes :: 5368709120
Sizes: [2]string = .["1gb", "5gb"];
UnitsPerDew :: 1000000
// The latest UTC second representable with a four-digit calendar year.
MaximumExpiry :: 253402300799

Plan :: struct {
    period: string #go_tag "json:\"period\""
    size: string #go_tag "json:\"size\""
    expires_at: s64 #go_tag "json:\"expires_at\""
    limit_bytes: s64 #go_tag "json:\"limit_bytes\""
    balance: s64 #go_tag "json:\"balance\""
    error: Error #go_tag "json:\"-\""
}

#scope_file
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";
AddDate :: (value: clock.Time, years: isize, months: isize, days: isize) -> clock.Time #foreign go_time "Time.AddDate";
Day :: (value: clock.Time) -> isize #foreign go_time "Time.Day";

ReadTx :: (transaction: *sql.Transaction, context: ctx.Context, user: string) -> Plan {
    result: Plan
    arguments: [1]Any = .[user]
    destinations: [3]Any = .[*result.period, *result.size, *result.expires_at]
    result.error = sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT period,size,expires_at FROM server_storage_plans WHERE user_id=?1", arguments[:]), destinations[:])
    if errors.Is(result.error, sql.NoRows()) {
        result.error = null
    }
    return result
}

SnapshotTx :: (transaction: *sql.Transaction, context: ctx.Context, user: string, now: s64) -> Plan {
    result := ReadTx(transaction, context, user)
    if result.error != null {
        return result
    }
    result.limit_bytes = ActiveBytes(result, now)
    balance := ledger.BalanceTx(transaction, context, user, receipts.AssetID)
    result.balance = balance.value
    result.error = balance.error
    return result
}

#scope_export
SchemaSQL :: () -> string {
    return #string SQL
CREATE TABLE IF NOT EXISTS server_storage_plans (
 user_id TEXT PRIMARY KEY REFERENCES server_users(user_id_hash) ON DELETE CASCADE,
 period TEXT NOT NULL CHECK(period IN ('monthly','yearly')), expires_at INTEGER NOT NULL,
 size TEXT NOT NULL DEFAULT '1gb'
);
CREATE TABLE IF NOT EXISTS server_storage_purchases (
 user_id TEXT NOT NULL REFERENCES server_users(user_id_hash) ON DELETE CASCADE,
 request_id TEXT NOT NULL, period TEXT NOT NULL, expires_at INTEGER NOT NULL,
 receipt_id TEXT NOT NULL, size TEXT NOT NULL DEFAULT '1gb', PRIMARY KEY(user_id,request_id)
);
SQL;
}

// The sizes a plan can buy. Zero for an unknown size.
SizeBytes :: (size: string) -> s64 {
    if size == "1gb" {
        return PaidBytes
    }
    if size == "5gb" {
        return LargeBytes
    }
    return 0
}

// An unexpired plan's allowance. Rows from before sizes existed are 1 GB.
ActiveBytes :: (plan: Plan, now: s64) -> s64 {
    if plan.expires_at <= now {
        return FreeBytes
    }
    bytes := SizeBytes(plan.size)
    if bytes == 0 {
        return PaidBytes
    }
    return bytes
}

// At 1000 Dew per XMR: 1 GB costs 0.2 XMR a month or 2 XMR a year, and 5 GB
// three times that.
Price :: (size: string, period: string) -> s64 {
    monthly: s64 = 0
    if size == "1gb" {
        monthly = 200 * UnitsPerDew
    } else if size == "5gb" {
        monthly = 600 * UnitsPerDew
    }
    if period == "monthly" {
        return monthly
    }
    if period == "yearly" {
        return monthly * 10
    }
    return 0
}

// The fixed node ratio quotes storage directly in Monero, without fiat prices.
// Round up to the smallest atomic amount that funds the complete purchase.
MoneroPrice :: (size: string, period: string, atomic: s64, units: s64) -> wallet.TokenUnitsResult {
    price := Price(size, period)
    result := wallet.TokenUnits(price, units, atomic)
    if result.error != null {
        return result
    }
    credited: wallet.TokenUnitsResult
    if result.value > 0 {
        credited = wallet.TokenUnits(result.value, atomic, units)
        if credited.error != null {
            return credited
        }
    }
    if credited.value < price {
        if result.value == 9223372036854775807 {
            result.error = errors.New("monero storage price overflow")
            return result
        }
        result.value += 1
    }
    return result
}

ConfigurationError :: (value: configuration.Config) -> Error {
    if !value.StoragePlansEnabled {
        return null
    }
    if value.TokenSecretEphemeral || value.TokenSecret.count < 32 {
        return errors.New("storage billing requires a stable token secret")
    }
    if policy.IssuerStatus(value) != "ok" {
        return errors.New("storage billing requires the Dew issuer private key")
    }
    if !Priced(value.MoneroRateAtomicAmount, value.MoneroRateTokenUnits) {
        return errors.New("storage billing requires valid fixed XMR prices")
    }
    if !value.TokenDirectPurchasesEnabled || value.MoneroWalletRPCURL == "" {
        return errors.New("storage billing requires Monero top-ups")
    }
    if value.MoneroNetwork != "mainnet" && value.MoneroNetwork != "stagenet" && value.MoneroNetwork != "testnet" {
        return errors.New("storage billing requires an explicit Monero network")
    }
    return null
}

// Whether every size and period has an XMR price at the node's ratio.
Priced :: (atomic: s64, units: s64) -> bool {
    for size: Sizes {
        monthly := MoneroPrice(size, "monthly", atomic, units)
        yearly := MoneroPrice(size, "yearly", atomic, units)
        if monthly.error != null || yearly.error != null {
            return false
        }
    }
    return true
}

// Remaining paid time moved to another size keeps its Dew value at the monthly
// prices: floor(remaining × old / new), computed without overflowing.
ConvertedSeconds :: (remaining: s64, from: string, to: string) -> s64 {
    source := Price(from, "monthly")
    target := Price(to, "monthly")
    if remaining <= 0 || source == 0 || target == 0 {
        return 0
    }
    return remaining / target * source + remaining % target * source / target
}

// Clamp to the last day of the target month, including February and leap years.
PeriodEnd :: (start: s64, period: string) -> s64 {
    value := clock.UTC(clock.FromUnix(start, 0))
    months: isize = ifx period == "yearly" then 12 else 1
    first := AddDate(value, 0, months, 1 - Day(value))
    last := AddDate(first, 0, 1, -1)
    day := Day(value)
    if day > Day(last) {
        day = Day(last)
    }
    return clock.Unix(AddDate(first, 0, 0, day - 1))
}

LimitTx :: (transaction: *sql.Transaction, context: ctx.Context, user: string,
    baseline: s64, enabled: bool, now: s64) -> ledger.BalanceResult {
    result: ledger.BalanceResult
    result.value = baseline
    if !enabled {
        return result
    }
    plan := ReadTx(transaction, context, user)
    result.error = plan.error
    result.value = ActiveBytes(plan, now)
    return result
}

Read :: (database: *sql.Database, context: ctx.Context, user: string, now: s64) -> Plan {
    result: Plan
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    RollbackAtReturn(opened.value)
    return SnapshotTx(opened.value, context, user, now)
}

Purchase :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey,
    user: string, size: string, period: string, key: string, now: s64) -> Plan {
    result: Plan
    price := Price(size, period)
    if price == 0 {
        result.error = errors.New("invalid storage plan")
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    arguments: [2]Any = .[user, key]
    destinations: [3]Any = .[*result.period, *result.size, *result.expires_at]
    previous := sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT period,size,expires_at FROM server_storage_purchases WHERE user_id=?1 AND request_id=?2",
        arguments[:]), destinations[:])
    if previous == null {
        if result.period != period || result.size != size {
            result.error = errors.New("storage request id reused")
            return result
        }
        return SnapshotTx(transaction, context, user, now)
    }
    if !errors.Is(previous, sql.NoRows()) {
        result.error = previous
        return result
    }
    result = ReadTx(transaction, context, user)
    if result.error != null {
        return result
    }
    // The same size extends the current plan; another size starts now with the
    // remaining time converted to it.
    start := now
    if result.expires_at > now {
        current := result.size
        if SizeBytes(current) == 0 {
            current = "1gb"
        }
        if current == size {
            start = result.expires_at
        } else {
            start = now + ConvertedSeconds(result.expires_at - now, current, size)
        }
    }
    expiry := PeriodEnd(start, period)
    if expiry <= start || expiry > MaximumExpiry {
        result.error = errors.New("storage expiry out of range")
        return result
    }
    event: receipts.TokenEventInput
    event.AccountID = user
    event.AppID = "inbe"
    event.EventType = "debit"
    event.AmountDelta = -price
    event.SourceType = "storage"
    event.SourceRef = key
    debit := ledger.SpendTx(transaction, context, signer, event, key,
        errors.New("Dew issuer unavailable"))
    result.error = debit.error
    if result.error != null {
        return result
    }
    result.period = period
    result.size = size
    result.expires_at = expiry
    result.limit_bytes = SizeBytes(size)
    result.balance = debit.balance
    planArguments: [4]Any = .[user, period, result.expires_at, size]
    saved := sql.ExecTx(transaction, context,
        "INSERT INTO server_storage_plans(user_id,period,expires_at,size) VALUES(?1,?2,?3,?4) ON CONFLICT(user_id) DO UPDATE SET period=excluded.period,expires_at=excluded.expires_at,size=excluded.size",
        planArguments[:])
    result.error = saved.error
    if result.error != null {
        return result
    }
    purchaseArguments: [6]Any = .[user, key, period, result.expires_at, debit.value.ReceiptID, size]
    saved = sql.ExecTx(transaction, context,
        "INSERT INTO server_storage_purchases(user_id,request_id,period,expires_at,receipt_id,size) VALUES(?1,?2,?3,?4,?5,?6)",
        purchaseArguments[:])
    result.error = saved.error
    if result.error == null {
        result.error = sql.Commit(transaction)
    }
    return result
}
