Store :: struct {
    database: *sql.Database
    path: string
}
StoreResult :: struct {
    value: *Store
    error: Error
}

ErrSyncUserNotFound: Error = errors.New("sync user not found");

#scope_file
Allocate :: () -> *Store #foreign builtin "new";

#scope_export
Open :: (path: string) -> StoreResult {
    openedStore := opened.Open(path)
    result: StoreResult
    if openedStore.error != null {
        result.error = openedStore.error
        return result
    }
    result.value = Allocate()
    result.value.database = openedStore.value
    result.value.path = path
    return result
}

Close :: (store: *Store) -> Error #go_method "Close" {
    return opened.Close(store.database)
}

ApplySync :: (store: *Store, context: ctx.Context,
    req: SyncRequest, publicKey: []u8) -> SyncResult, Error #go_method "ApplySync" #go_results {
    result, _, err := ApplySyncDetailed(store, context, req, publicKey)
    return result, err
}

ApplySyncDetailed :: (store: *Store, context: ctx.Context,
    req: SyncRequest, publicKey: []u8) -> SyncResult, []string, Error #go_method "ApplySyncDetailed" #go_results {
    result := sync.Apply(store.database, context, req, publicKey, ErrSyncUserNotFound)
    return result.value, result.accepted, result.error
}

RegisterUser :: (store: *Store, context: ctx.Context,
    userID: string, publicKey: []u8) -> Error #go_method "RegisterUser" {
    return state.Register(store.database, context, userID, publicKey)
}

