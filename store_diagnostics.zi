#import "std/go_types"
#import "std/map_go"
#import "types"
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
state :: #import "account_state";
hashes :: #import "state_hash";
clients :: #import "sync_clients";
audit :: #import "sync_audit";
payloads :: #import "encrypted_payloads";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
strings :: #system_library "go:strings";
format :: #system_library "go:fmt";

TableCountsResult :: struct {
    value: Map(string, isize)
    error: Error
}
DiagnosticReportResult :: struct {
    value: SyncDiagnosticReport
    error: Error
}

#scope_file
Ping :: (database: *sql.Database, context: ctx.Context) -> Error #foreign native "(*DB).PingContext";
QuickCheckError :: (format: string, value: string) -> Error #foreign format "Errorf";
Join :: (parts: []string, separator: string) -> string #foreign strings;

#scope_export
Health :: (database: *sql.Database, context: ctx.Context) -> Error {
    error := Ping(database, context)
    if error != null {
        return error
    }
    empty: [0]Any
    status: string
    statusDestinations: [1]Any = .[*status]
    row := sql.QueryRow(database, context, "PRAGMA quick_check", empty[:])
    error = sql.ScanRow(row, statusDestinations[:])
    if error != null {
        return error
    }
    if status != "ok" {
        return QuickCheckError("sqlite quick_check: %s", status)
    }
    exists: isize
    destinations: [1]Any = .[*exists]
    tableRow := sql.QueryRow(database, context, "\nSELECT EXISTS(SELECT 1 FROM sqlite_master WHERE type='table' AND name='server_users')", empty[:])
    error = sql.ScanRow(tableRow, destinations[:])
    if error != null {
        return error
    }
    if exists == cast(isize)0 {
        return errors.New("schema not migrated")
    }
    return null
}

TableCounts :: (database: *sql.Database, context: ctx.Context, userID: string) -> TableCountsResult {
    result: TableCountsResult
    counts: Map(string, isize)
    MapInit(counts)
    arguments: [1]Any = .[userID]
    for table: CountTables {
        parts: [3]string = .["SELECT COUNT(*) FROM ", table, " WHERE user_id_hash=?1"]
        count: isize
        destinations: [1]Any = .[*count]
        row := sql.QueryRow(database, context, Join(parts[:], ""), arguments[:])
        result.error = sql.ScanRow(row, destinations[:])
        if result.error != null {
            return result
        }
        MapSet(counts, table, count)
    }
    result.value = counts
    return result
}

Report :: (database: *sql.Database, context: ctx.Context, userID: string) -> DiagnosticReportResult {
    result: DiagnosticReportResult
    version := state.CurrentVersion(database, context, userID)
    result.error = version.error
    if result.error != null {
        return result
    }
    hash := hashes.State(database, context, userID)
    result.error = hash.error
    if result.error != null {
        return result
    }
    compaction := clients.Compacted(database, context, userID, version.value)
    result.error = compaction.error
    if result.error != null {
        return result
    }
    counts := TableCounts(database, context, userID)
    result.error = counts.error
    if result.error != null {
        return result
    }
    legacy := clients.Legacy(database, context, userID, cast(isize)3)
    result.error = legacy.error
    if result.error != null {
        return result
    }
    recentAudit := audit.Recent(database, context, userID, cast(isize)10)
    result.error = recentAudit.error
    if result.error != null {
        return result
    }
    recentPayloads := payloads.Recent(database, context, userID, cast(isize)5)
    result.error = recentPayloads.error
    if result.error != null {
        return result
    }
    payloadBytes := payloads.Bytes(database, context, userID)
    result.error = payloadBytes.error
    if result.error != null {
        return result
    }
    report: SyncDiagnosticReport
    report.Status = "ok"
    report.UserIDHash = userID
    report.ServerVersion = version.value
    report.StateHash = hash.value
    report.CompactedThroughVersion = compaction.through
    report.TableCounts = counts.value
    report.EncryptedPayloadBytes = payloadBytes.value
    report.LegacyClients = legacy.value
    report.ActiveWebSocketSupported = true
    report.RecentSyncAudit = recentAudit.value
    report.RecentEncryptedPayloads = recentPayloads.value
    result.value = report
    return result
}

#scope_file
CountTables: [11]string = .[
    "server_habits", "server_habit_days", "server_sessions", "server_session_rounds",
    "server_meditation_logs", "server_social_snapshots", "server_encrypted_records",
    "server_sync_ops", "server_clients", "server_encrypted_payloads", "server_sync_audit"
];
