RecordsSince :: (database: *sql.Database, context: ctx.Context, userID: string, sinceVersion: s64) -> RecordsResult {
    arguments: [2]Any = .[userID, sinceVersion]
    result: RecordsResult
    queried := sql.Query(database, context,
