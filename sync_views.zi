CleanHabits :: (database: *sql.Database, context: ctx.Context, userID: string) -> HabitsResult {
    arguments: [1]Any = .[userID]
    result: HabitsResult
    queried := sql.Query(database, context,
        "\nSELECT id,name,color_r,color_g,color_b,sync_mode,sync_activity,counter_enabled,sort_order,deleted_at,updated_at\nFROM server_habits\nWHERE user_id_hash=?1 AND deleted_at=0\nORDER BY sort_order,id", arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    CloseRowsAtReturn(queried.value)
    return ReadHabits(queried.value, false)
}

CleanHabitDays :: (database: *sql.Database, context: ctx.Context, userID: string) -> CleanHabitDaysResult {
    arguments: [1]Any = .[userID]
    result: CleanHabitDaysResult
    queried := sql.Query(database, context,
        "\nSELECT hd.habit_id,h.name,hd.local_date,hd.completed,hd.count,hd.updated_at\nFROM server_habit_days hd\nJOIN server_habits h ON h.user_id_hash=hd.user_id_hash AND h.id=hd.habit_id\nWHERE hd.user_id_hash=?1\n  AND h.deleted_at=0\n  AND (hd.completed!=0 OR hd.count>0)\nORDER BY hd.local_date DESC,h.sort_order,hd.habit_id", arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    CloseRowsAtReturn(queried.value)
    return ReadCleanHabitDays(queried.value)
}

CleanSessions :: (database: *sql.Database, context: ctx.Context, userID: string) -> SessionsResult {
    arguments: [1]Any = .[userID]
    return ReadSessionQuery(database, context, userID,
        "\n\tSELECT id,started_at,local_date,topic,activity,source,rounds_hash,\n\t       mood_before,mood_after,energy,stress,note,tags,deleted_at,updated_at\n\tFROM server_sessions\n\tWHERE user_id_hash=?1 AND deleted_at=0\n\tORDER BY started_at DESC,id", arguments[:])
}

CleanMeditations :: (database: *sql.Database, context: ctx.Context, userID: string) -> MeditationsResult {
    arguments: [1]Any = .[userID]
    result: MeditationsResult
    queried := sql.Query(database, context,
        "\nSELECT id,session_id,duration_seconds,completed_at\nFROM server_meditation_logs\nWHERE user_id_hash=?1\nORDER BY completed_at DESC,id", arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    CloseRowsAtReturn(queried.value)
    return ReadMeditations(queried.value)
}

Changes :: (database: *sql.Database, context: ctx.Context, userID: string, sinceVersion: s64) -> ChangesResult {
    result: ChangesResult
    habits := HabitsSince(database, context, userID, sinceVersion)
    result.value.Habits = habits.value
    result.error = habits.error
    if result.error != null {
        return result
    }
    days := HabitDaysSince(database, context, userID, sinceVersion)
    result.value.HabitDays = days.value
    result.error = days.error
    if result.error != null {
        return result
    }
    sessions := SessionsSince(database, context, userID, sinceVersion)
    result.value.Sessions = sessions.value
    result.error = sessions.error
    if result.error != null {
        return result
    }
    meditations := MeditationsSince(database, context, userID, sinceVersion)
    result.value.MeditationLogs = meditations.value
    result.error = meditations.error
    if result.error != null {
        return result
    }
    social := SocialSince(database, context, userID, sinceVersion)
    result.value.SocialCache = social.value
    result.error = social.error
    if result.error != null {
        return result
    }
    records := RecordsSince(database, context, userID, sinceVersion)
    result.value.EncryptedRecords = records.value
    result.error = records.error
    if result.error != null {
        return result
    }
    version := state.CurrentVersion(database, context, userID)
    result.error = version.error
    if result.error == null {
        result.version = version.value
    }
    return result
}

Clean :: (database: *sql.Database, context: ctx.Context, userID: string) -> CleanResult {
    result: CleanResult
    habits := CleanHabits(database, context, userID)
    result.error = habits.error
    if result.error != null {
        return result
    }
    days := CleanHabitDays(database, context, userID)
    result.error = days.error
    if result.error != null {
        return result
    }
    sessions := CleanSessions(database, context, userID)
    result.error = sessions.error
    if result.error != null {
        return result
    }
    meditations := CleanMeditations(database, context, userID)
    result.error = meditations.error
    if result.error != null {
        return result
    }
    social := friends.Authoritative(database, context, userID)
    result.error = social.error
    if result.error != null {
        return result
    }
    records := RecordsSince(database, context, userID, 0)
    result.error = records.error
    if result.error != null {
        return result
    }
    value := AllocateClean()
    value.Habits = habits.value
    value.HabitDays = days.value
    value.Sessions = sessions.value
    value.MeditationLogs = meditations.value
    value.Social = social.value
    value.EncryptedRecords = records.value
    value.Friends = cast(RawMessage)text.ToBytes("{\"friends\":[]}")
    value.FriendRequests = cast(RawMessage)text.ToBytes("{\"incoming\":[],\"outgoing\":[]}")
    for item: social.value {
        if item.Kind == "friends.list" {
            value.Friends = item.JSON
        } else if item.Kind == "friends.requests" {
            value.FriendRequests = item.JSON
        }
    }
    result.value = value
    return result
}
