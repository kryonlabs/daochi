  "/api/v1/lumi/telegram/webhook": {
    "post": {
      "summary": "Accept private-chat updates from the dedicated Lumi bot",
      "description": "Requires X-Telegram-Bot-Api-Secret-Token. Only numeric sender identities in their own private chats are accepted. Duplicate update IDs cannot execute a second action.",
      "responses": {
        "200": {
          "description": "Accepted or ignored"
