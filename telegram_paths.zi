        }
      ],
      "responses": {
        "200": {
          "description": "Link status and next claimed update"
        },
        "400": {
          "description": "Invalid client"
        },
        "401": {
          "description": "Sign in required"
        }
      }
    }
  },
  "/api/v1/lumi/telegram/ack": {
    "post": {
      "summary": "Acknowledge an action claimed by this app client",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Acknowledged"
        },
        "400": {
          "description": "Invalid receipt"
        },
        "401": {
          "description": "Sign in required"
        }
      }
    }
  },
  "/api/v1/lumi/telegram/messages": {
    "post": {
      "summary": "Mirror a new Lumi conversation message to the linked Telegram chat",
      "description": "Idempotent per account and message ID. Pending feedback carries Yes/No buttons. Messages from before linking are not replayed unsolicited. An uncertain external send is kept for inspection instead of automatically duplicated.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
