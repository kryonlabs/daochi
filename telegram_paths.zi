  "/api/v1/telegram/environment": {
    "get": {
      "summary": "Read the issuing node and production bot identity",
      "description": "Issuing-node only. Entries expire after ten minutes. Telegram identity is verified server-side; no owner private key or recovery passphrase is accepted. Status, cancel and bind require fresh one-use key proofs. Bind additionally requires an existing owner bearer and unchanged v6 owner/device transaction signatures.",
      "responses": {
        "200": {
          "description": "Verified result"
        },
        "400": {
          "description": "Malformed proof"
        },
        "401": {
          "description": "Identity or signature rejected"
        },
        "409": {
          "description": "Expired, conflicting, or replayed entry"
        }
      }
    }
  },
