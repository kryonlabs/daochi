  "/api/v1/lumi/telegram/updates": {
    "get": {
      "summary": "Claim the next app action or owner feedback message",
      "description": "Requires a stable 64-character app client identifier. Each update belongs to one executor. Owner feedback is restricted to the configured immutable account ID.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "parameters": [
        {
          "name": "client",
