  "/api/v1/lumi/telegram/link": {
    "post": {
      "summary": "Create a one-use Lumi Telegram account link",
      "description": "Authenticated account only. The link expires after ten minutes. Account signing keys stay in the app.",
      "security": [
        {
          "bearerAuth": []
        }
      ],
      "responses": {
        "200": {
          "description": "Bot deep link"
