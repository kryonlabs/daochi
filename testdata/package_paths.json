{
  "/api/v1/packages/{app_id}/{asset}": {
    "get": {
      "summary": "Read an app's desktop portable release",
      "parameters": [
        {
          "name": "app_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "asset",
          "in": "path",
          "required": true,
          "description": "latest or the release SHA-256 followed by .zib",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Signed release metadata or the portable bundle"
        },
        "404": {
          "description": "App or release is unavailable"
        }
      }
    }
  },
  "/api/v2/packages/{app_id}/{asset}": {
    "get": {
      "summary": "Read an app's portable release for current hosts",
      "parameters": [
        {
          "name": "app_id",
          "in": "path",
          "required": true,
          "schema": {
            "type": "string"
          }
        },
        {
          "name": "asset",
          "in": "path",
          "required": true,
          "description": "latest or the release SHA-256 followed by .zib",
          "schema": {
            "type": "string"
          }
        }
      ],
      "responses": {
        "200": {
          "description": "Signed release metadata or the portable bundle"
        },
        "404": {
          "description": "App or release is unavailable"
        }
      }
    }
  }
}
