clock :: #import "std/time_go";
go_strings :: #system_library "go:strings";

// Fixed-width UTC fractions keep stored timestamps in chronological string order.
CanonicalTimestampLayout :: "2006-01-02T15:04:05.000000000Z07:00";
MinCanonicalTimestamp :: "0001-01-01T00:00:00.000000000Z";

TimestampResult :: struct {
    value: clock.Time
    valid: bool
}

CanonicalNow :: () -> string {
    return CanonicalTimestamp(clock.Now())
}

CanonicalTimestamp :: (value: clock.Time) -> string {
    return clock.Format(clock.UTC(value), CanonicalTimestampLayout)
}

ParseTimestamp :: (value: string) -> TimestampResult {
    parsed := clock.Parse("2006-01-02T15:04:05.999999999Z07:00", value)
    if parsed.error == null {
        result: TimestampResult
        result.value = parsed.value
        result.valid = true
        return result
    }
    parsed = clock.Parse("2006-01-02 15:04:05", value)
    if parsed.error == null {
        result: TimestampResult
        result.value = parsed.value
        result.valid = true
        return result
    }
    result: TimestampResult
    return result
}

NormalizeTime :: (primary: string, fallback: string) -> string {
    value := primary
    if value == "" {
        value = fallback
    }
    if value == "" {
        return CanonicalNow()
    }
    parsed := ParseTimestamp(value)
    if parsed.valid {
        return CanonicalTimestamp(parsed.value)
    }
    return MinCanonicalTimestamp
}

// Records resolve by last writer, so a time far ahead of this node's clock
// would block every later edit. A write may run at most five minutes ahead,
// which still allows ordinary device clock drift. A stored time beyond this
// limit predates it, so callers let any edit replace that record.
WriteTimeLimit :: (now: clock.Time) -> string {
    return CanonicalTimestamp(clock.Add(now, cast(clock.Duration)300000000000))
}

NormalizeWriteTime :: (primary: string, now: clock.Time) -> string {
    value := NormalizeTime(primary, "")
    latest := WriteTimeLimit(now)
    if Compare(value, latest) > cast(isize)0 {
        return latest
    }
    return value
}

#scope_file
Compare :: (left: string, right: string) -> isize #foreign go_strings;
