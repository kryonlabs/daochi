// A one-time Dew gift to every account the node already has. Each account is
// credited through the signed payment-credit path with the gift's name and the
// account as its payment ID, so running the same gift again credits nobody.
#import "std/go_types"
#import "protocol"
ledger :: #import "token_ledger";
receipts :: #import "token_receipt";
identity :: #import "identity";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
ed :: #import "std/ed25519_go";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";

GiftProvider :: "gift-v1";

GiftResult :: struct {
    // Accounts holding this gift after the run, and those credited by it.
    accounts: s64
    credited: s64
    units: s64
    error: Error
}

#scope_file
AccountsResult :: struct {
    value: []string
    error: Error
}
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";
AppendAccount :: (values: []string, value: string) -> []string #foreign builtin "append";
Join :: (values: []string, separator: string) -> string #foreign go_strings;

// Read every account before writing, so no query stays open.
AccountsTx :: (transaction: *sql.Transaction, context: ctx.Context) -> AccountsResult {
    result: AccountsResult
    arguments: [0]Any
    queried := sql.QueryTx(transaction, context,
        "SELECT user_id_hash FROM server_users ORDER BY user_id_hash", arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    defer sql.CloseRows(queried.value)
    while sql.Next(queried.value) {
        account: string
        destinations: [1]Any = .[*account]
        result.error = sql.ScanRows(queried.value, destinations[:])
        if result.error != null {
            return result
        }
        result.value = AppendAccount(result.value, account)
    }
    result.error = sql.RowsError(queried.value)
    return result
}

GivenTx :: (transaction: *sql.Transaction, context: ctx.Context, prefix: string) -> ledger.BalanceResult {
    result: ledger.BalanceResult
    arguments: [2]Any = .[GiftProvider, prefix]
    destinations: [1]Any = .[*result.value]
    result.error = sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT COUNT(*) FROM token_processed_payments WHERE provider=?1 AND substr(provider_payment_id,1,length(?2))=?2",
        arguments[:]), destinations[:])
    return result
}

#scope_export
Give :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey, gift: string, units: s64) -> GiftResult {
    result: GiftResult
    result.units = units
    if !identity.ValidNamespace(gift) || units <= 0 {
        result.error = errors.New("invalid gift")
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    prefixParts: [2]string = .[gift, ":"]
    prefix := Join(prefixParts[:], "")
    before := GivenTx(transaction, context, prefix)
    result.error = before.error
    if result.error != null {
        return result
    }
    accounts := AccountsTx(transaction, context)
    result.error = accounts.error
    if result.error != null {
        return result
    }
    for account: accounts.value {
        event: receipts.TokenEventInput
        event.AccountID = account
        event.EventType = "credit"
        event.AmountDelta = units
        event.SourceType = "gift"
        event.SourceRef = gift
        paymentParts: [2]string = .[prefix, account]
        credited := ledger.CreditPaymentTx(transaction, context, signer, GiftProvider,
            Join(paymentParts[:], ""), event, errors.New("Dew issuer unavailable"))
        result.error = credited.error
        if result.error != null {
            return result
        }
    }
    after := GivenTx(transaction, context, prefix)
    result.error = after.error
    if result.error != null {
        return result
    }
    result.accounts = after.value
    result.credited = after.value - before.value
    result.error = sql.Commit(transaction)
    return result
}
