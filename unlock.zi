// Server-priced unlocks. The node names each product's price; a client names
// only the product. The signed Dew debit and the unlock commit together.
#import "std/go_types"
#import "protocol"
ledger :: #import "token_ledger";
receipts :: #import "token_receipt";
plans :: #import "storage_plan";
sql :: #import "std/sql_go";
ctx :: #import "std/context_go";
ed :: #import "std/ed25519_go";
errors :: #import "std/errors_go";
native :: #system_library "go:database/sql";
go_strings :: #system_library "go:strings";
builtin :: #system_library "go:builtin";
clock :: #import "std/time_go";
go_time :: #system_library "go:time";

TaiChi :: "inbe.practice.taichi";
ShoveyIsland :: "shovey.island";
IslandRegularUnits :: 85000000;
IslandSaleUnits :: 51000000;
// The launch offer takes 40% off until the node's configured trial end.
TrialDiscountPercent :: 40

AccountUnlock :: struct {
    product: string #go_tag "json:\"product\""
    receipt_id: string #go_tag "json:\"receipt_id\""
    created_at: s64 #go_tag "json:\"created_at\""
}
UnlockProduct :: struct {
    product: string #go_tag "json:\"product\""
    price_units: s64 #go_tag "json:\"price_units\""
    regular_price_units: s64 #go_tag "json:\"regular_price_units\""
    trial_until: s64 #go_tag "json:\"trial_until\""
}
UnlockResult :: struct {
    product: string #go_tag "json:\"product\""
    unlocked: bool #go_tag "json:\"unlocked\""
    price_units: s64 #go_tag "json:\"price_units\""
    balance: s64 #go_tag "json:\"balance\""
    receipt_id: string #go_tag "json:\"receipt_id\""
    error: Error #go_tag "json:\"-\""
}
UnlocksResult :: struct {
    unlocks: []AccountUnlock #go_tag "json:\"unlocks\""
    products: []UnlockProduct #go_tag "json:\"products\""
    error: Error #go_tag "json:\"-\""
}
// The node's prices alone, which anyone may read.
UnlockPrices :: struct {
    products: []UnlockProduct #go_tag "json:\"products\""
}
UnlockOwnedResult :: struct {
    value: bool
    error: Error
}

#scope_file
// One sellable product. A zero price means the node does not sell it.
Offer :: struct {
    product: string
    app_id: string
    units: s64
}
Catalog: [2]string = .[TaiChi, ShoveyIsland];
AddDate :: (value: clock.Time, years: isize, months: isize, days: isize) -> clock.Time #foreign go_time "Time.AddDate";
RollbackAtReturn :: (transaction: *sql.Transaction) #go_defer #foreign native "(*Tx).Rollback";
MakeUnlocks :: (count: isize) -> []AccountUnlock #foreign builtin "make";
AppendUnlock :: (values: []AccountUnlock, value: AccountUnlock) -> []AccountUnlock #foreign builtin "append";
MakeProducts :: (count: isize) -> []UnlockProduct #foreign builtin "make";
AppendProduct :: (values: []UnlockProduct, value: UnlockProduct) -> []UnlockProduct #foreign builtin "append";
Join :: (values: []string, separator: string) -> string #foreign go_strings;

Find :: (product: string) -> Offer {
    result: Offer
    if product == TaiChi {
        result.product = TaiChi
        result.app_id = "inbe"
        result.units = 100 * plans.UnitsPerDew
    }
    if product == ShoveyIsland {
        result.product = ShoveyIsland
        result.app_id = "shovey"
        result.units = IslandRegularUnits
    }
    return result
}

// The receipt that paid for the unlock names what was charged.
SettledTx :: (transaction: *sql.Transaction, context: ctx.Context, account: string,
    product: string, receiptID: string) -> UnlockResult {
    result: UnlockResult
    result.product = product
    receipt := ledger.ByIDTx(transaction, context, receiptID)
    result.error = receipt.error
    if result.error != null {
        return result
    }
    if !receipt.found {
        result.error = errors.New("unlock receipt missing")
        return result
    }
    // A caller-controlled generic spend nonce is never proof of an unlock.
    offer := Find(product)
    value := receipt.value
    legacyIsland := product == ShoveyIsland && value.AppID == "entity"
    if value.AccountID != account || (value.AppID != offer.app_id && !legacyIsland) ||
    value.AssetID != receipts.AssetID || value.EventType != "debit" ||
    value.SourceType != "unlock" || value.SourceRef != product || value.AmountDelta >= 0 ||
    (product == ShoveyIsland && value.AmountDelta != -IslandRegularUnits && value.AmountDelta != -IslandSaleUnits) {
        result.error = errors.New("invalid unlock receipt")
        return result
    }
    balance := ledger.BalanceTx(transaction, context, account, receipts.AssetID)
    result.error = balance.error
    if result.error != null {
        return result
    }
    result.unlocked = true
    result.price_units = -receipt.value.AmountDelta
    result.balance = balance.value
    result.receipt_id = receiptID
    return result
}

#scope_export
SchemaSQL :: () -> string {
    return #string SQL
CREATE TABLE IF NOT EXISTS account_unlocks (
 account_id TEXT NOT NULL REFERENCES server_users(user_id_hash) ON DELETE CASCADE,
 product TEXT NOT NULL, receipt_id TEXT NOT NULL, created_at INTEGER NOT NULL,
 PRIMARY KEY(account_id,product)
);
SQL;
}

RegularPrice :: (product: string) -> s64 {
    offer := Find(product)
    return offer.units
}

// The price charged now. Zero for a product the node does not sell.
Price :: (product: string, now: s64, trialUntil: s64) -> s64 {
    regular := RegularPrice(product)
    if product != ShoveyIsland && now < trialUntil {
        return regular * (100 - TrialDiscountPercent) / 100
    }
    return regular
}

IslandSaleUntil :: (start: s64) -> s64 {
    if start <= 0 {
        return 0
    }
    return clock.Unix(AddDate(clock.UTC(clock.FromUnix(start, 0)), 0, 6, 0))
}

ProductPrice :: (product: string, now: s64, trialUntil: s64, islandStart: s64) -> s64 {
    if product == ShoveyIsland {
        if islandStart > 0 && now >= islandStart && now < IslandSaleUntil(islandStart) {
            return IslandSaleUnits
        }
        return IslandRegularUnits
    }
    return Price(product, now, trialUntil)
}

Products :: (now: s64, trialUntil: s64) -> []UnlockProduct {
    return ProductsAt(now, trialUntil, 0)
}

ProductsAt :: (now: s64, trialUntil: s64, islandStart: s64) -> []UnlockProduct {
    result := MakeProducts(cast(isize)0)
    for name: Catalog {
        item: UnlockProduct
        item.product = name
        item.price_units = ProductPrice(name, now, trialUntil, islandStart)
        item.regular_price_units = RegularPrice(name)
        // Zero once the trial is over, so a nonzero value always means a lower price.
        if name != ShoveyIsland && now < trialUntil {
            item.trial_until = trialUntil
        }
        result = AppendProduct(result, item)
    }
    return result
}

Owned :: (database: *sql.Database, context: ctx.Context, account: string, product: string) -> UnlockOwnedResult {
    result: UnlockOwnedResult
    receiptID: string
    arguments: [2]Any = .[account, product]
    destinations: [1]Any = .[*receiptID]
    result.error = sql.ScanRow(sql.QueryRow(database, context,
        "SELECT receipt_id FROM account_unlocks WHERE account_id=?1 AND product=?2", arguments[:]), destinations[:])
    if errors.Is(result.error, sql.NoRows()) {
        result.error = null
        return result
    }
    result.value = result.error == null
    return result
}

List :: (database: *sql.Database, context: ctx.Context, account: string, now: s64, trialUntil: s64) -> UnlocksResult {
    result: UnlocksResult
    result.unlocks = MakeUnlocks(cast(isize)0)
    result.products = Products(now, trialUntil)
    arguments: [1]Any = .[account]
    queried := sql.Query(database, context,
        "SELECT product,receipt_id,created_at FROM account_unlocks WHERE account_id=?1 ORDER BY created_at,product", arguments[:])
    result.error = queried.error
    if result.error != null {
        return result
    }
    defer sql.CloseRows(queried.value)
    while sql.Next(queried.value) {
        item: AccountUnlock
        destinations: [3]Any = .[*item.product, *item.receipt_id, *item.created_at]
        result.error = sql.ScanRows(queried.value, destinations[:])
        if result.error != null {
            return result
        }
        result.unlocks = AppendUnlock(result.unlocks, item)
    }
    result.error = sql.RowsError(queried.value)
    return result
}

// Unlocking twice charges once. A product is paid for once per account under
// the key unlock:<product>; an account deleted and restored keeps that payment
// even if the price changed since.
Unlock :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey,
    account: string, product: string, now: s64, trialUntil: s64) -> UnlockResult {
    return Confirmed(database, context, signer, account, product, now, trialUntil, 0, 0)
}

Confirmed :: (database: *sql.Database, context: ctx.Context, signer: ed.PrivateKey,
    account: string, product: string, now: s64, trialUntil: s64, islandStart: s64, expectedUnits: s64) -> UnlockResult {
    result: UnlockResult
    result.product = product
    offer := Find(product)
    if offer.units <= 0 {
        result.error = errors.New("unknown product")
        return result
    }
    opened := sql.Begin(database, context, null)
    result.error = opened.error
    if result.error != null {
        return result
    }
    transaction := opened.value
    RollbackAtReturn(transaction)
    receiptID: string
    arguments: [2]Any = .[account, product]
    destinations: [1]Any = .[*receiptID]
    existing := sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT receipt_id FROM account_unlocks WHERE account_id=?1 AND product=?2", arguments[:]), destinations[:])
    if existing == null {
        return SettledTx(transaction, context, account, product, receiptID)
    }
    if !errors.Is(existing, sql.NoRows()) {
        result.error = existing
        return result
    }
    keyParts: [2]string = .["unlock:", product]
    key := Join(keyParts[:], "")
    paidArguments: [3]Any = .[account, offer.app_id, key]
    paid := sql.ScanRow(sql.QueryRowTx(transaction, context,
        "SELECT receipt_id FROM token_spend_nonces WHERE account_id=?1 AND app_id=?2 AND idempotency_key=?3",
        paidArguments[:]), destinations[:])
    // A released Island payment used the shared Entity audit scope. Preserve
    // that signed payment when restoring an already settled unlock.
    if product == ShoveyIsland && errors.Is(paid, sql.NoRows()) {
        legacyArguments: [3]Any = .[account, "entity", key]
        paid = sql.ScanRow(sql.QueryRowTx(transaction, context,
            "SELECT receipt_id FROM token_spend_nonces WHERE account_id=?1 AND app_id=?2 AND idempotency_key=?3",
            legacyArguments[:]), destinations[:])
    }
    if paid != null && !errors.Is(paid, sql.NoRows()) {
        result.error = paid
        return result
    }
    if paid != null {
        price := ProductPrice(product, now, trialUntil, islandStart)
        if product == ShoveyIsland && (expectedUnits <= 0 || expectedUnits != price) {
            result.error = errors.New("price changed; confirm a fresh quote")
            return result
        }
        event: receipts.TokenEventInput
        event.AccountID = account
        event.AppID = offer.app_id
        event.EventType = "debit"
        event.AmountDelta = -price
        event.SourceType = "unlock"
        event.SourceRef = product
        debit := ledger.SpendTx(transaction, context, signer, event, key,
            errors.New("Dew issuer unavailable"))
        result.error = debit.error
        if result.error != null {
            return result
        }
        receiptID = debit.value.ReceiptID
    }
    saveArguments: [4]Any = .[account, product, receiptID, now]
    saved := sql.ExecTx(transaction, context,
        "INSERT INTO account_unlocks(account_id,product,receipt_id,created_at) VALUES(?1,?2,?3,?4)",
        saveArguments[:])
    result.error = saved.error
    if result.error != null {
        return result
    }
    result = SettledTx(transaction, context, account, product, receiptID)
    if result.error == null {
        result.error = sql.Commit(transaction)
    }
    return result
}
