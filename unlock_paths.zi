#import "std/go_types"
#import "std/map_go"
json :: #import "std/json_go";
text :: #import "std/text_go";

Paths :: () -> Map(string, Any) {
    paths: Map(string, Any)
    json.Unmarshal(text.ToBytes(Document), *paths)
    return paths
}

Document :: #string JSON
{"/api/v1/unlocks":{"get":{"summary":"List the account's unlocks and the node's unlock prices","description":"Account bearer required. Returns unlocks [{product,receipt_id,created_at}] and products [{product,price_units,regular_price_units,trial_until}]. Prices are millionths of Dew. Active offers charge 60% of regular. Island is 85000000 regular or 51000000 at launch; trial_until is always 0 for Island.","responses":{"200":{"description":"Account unlocks and current prices; no-store"},"401":{"description":"Account authentication required"},"503":{"description":"Unlocks unavailable"}}},"post":{"summary":"Unlock a product with Dew at the node's price","description":"Node-priced atomic debit and unlock. Returns {product,unlocked,price_units,balance,receipt_id}. Already paid products restore the original receipt and price without charging. Island requires expected_units matching the current quote; stale or missing confirmation returns 409 without debit.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["product"],"properties":{"product":{"type":"string","maxLength":64},"expected_units":{"type":"integer","description":"Required for Shovey Island: exact current price_units confirmed by the account."}}}}}},"responses":{"200":{"description":"Unlocked, with the charged price and current balance"},"400":{"description":"Malformed request"},"401":{"description":"Account authentication required"},"402":{"description":"Insufficient balance"},"404":{"description":"Unknown product"},"503":{"description":"Unlocks unavailable"},"409":{"description":"Price changed; fetch and confirm a fresh quote before purchase"}}}},"/api/v1/unlocks/grant":{"post":{"summary":"Get a one-hour download grant for an unlocked product","description":"Returns {grant,expires_at}. The grant is base64url(payload).base64url(Ed25519 signature) by the Dew issuer; the payload is daochi-pack-grant-v1, the product and the Unix expiry, separated by newlines. Append it as the last path segment of a gated package artifact URL.","requestBody":{"required":true,"content":{"application/json":{"schema":{"type":"object","required":["product"],"properties":{"product":{"type":"string","maxLength":64}}}}}},"responses":{"200":{"description":"Grant and expiry; no-store"},"400":{"description":"Malformed request"},"401":{"description":"Account authentication required"},"403":{"description":"The account has not unlocked this product"},"503":{"description":"Grants unavailable"}}}},"/api/v1/unlocks/products":{"get":{"summary":"List the node's unlock prices","description":"Public. Returns products [{product,price_units,regular_price_units,trial_until}] as in GET /api/v1/unlocks, so an app can show a trial offer before the person signs in.","responses":{"200":{"description":"Current prices; no-store"}}}}}
JSON;
